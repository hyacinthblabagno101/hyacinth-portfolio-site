---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Proof from '../components/Proof.astro';
import Skills from '../components/Skills.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Showcase from '../components/Showcase.astro';
import Testimonials from '../components/Testimonials.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import { showAbout, showExperience } from '../lib/data';
---

<Base>
  {/* Proof first: hero, the work, then the numbers and brands, then roles and what clients said */}
  <Hero />
  <Showcase />
  <Proof />
  {showExperience && <Experience />}
  <Testimonials />
  {showAbout && <About />}
  <Skills />
  <Contact />
  <CaseStudies />
</Base>
