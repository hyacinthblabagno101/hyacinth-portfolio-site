---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Proof from '../components/Proof.astro';
import Brands from '../components/Brands.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Showcase from '../components/Showcase.astro';
import Testimonials from '../components/Testimonials.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Hiring from '../components/Hiring.astro';
import { showAbout, showExperience } from '../lib/data';
---

<Base>
  {/* Hero, the brands I've worked with, the work, the numbers, then roles and what clients said */}
  <Hero />
  <Brands />
  <Showcase />
  <Proof />
  {showExperience && <Experience />}
  <Testimonials />
  {showAbout && <About />}
  <Hiring />
  <Contact />
  <CaseStudies />
</Base>
