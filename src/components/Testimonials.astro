---
/**
 * Client feedback, word for word. Text lives in "testimonials" in src/data/proof.json.
 * The first 3 quotes show as cards (reorder proof.json to change which); "More feedback" shows the rest.
 * A quote with a url is verified on Upwork and gets a small badge linking there.
 * - Hover lifts a card. Long quotes show their first lines with "Read more" to open the rest.
 * - No ratings or badges: only what clients actually wrote.
 */
import { proof } from '../lib/data';

const SHOWN = 3;
const LONG = 220; // characters; longer quotes start folded

const quotes = proof.testimonials.map((t, i) => ({ ...t, id: `quote-${i + 1}`, long: t.quote.length > LONG, extra: i >= SHOWN }));
---

<section id="feedback" class="feedback" aria-labelledby="feedback-title">
  <div class="wrap">
    <header class="section-head reveal">
      <h2 id="feedback-title">Client <em>feedback</em></h2>
      <p class="lede">A few words from brands I've worked with directly.</p>
    </header>

    <ul class="cards" role="list">
      {quotes.map((t, i) => (
        <li class:list={['reveal', { extra: t.extra }]} style={`--delay: ${(i % 3) * 80}ms`}>
          <figure class="card">
            <span class="mark" aria-hidden="true">&ldquo;</span>
            <blockquote id={t.id} class:list={['quote', { folded: t.long }]}>
              <p>{t.quote}</p>
            </blockquote>
            {t.long && (
              <button type="button" class="more" aria-expanded="false" aria-controls={t.id} data-more-quote>
                Read more
              </button>
            )}
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.role}</span>
              {t.url && (
                <a class="verified" href={t.url} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" /></svg>
                  Verified on Upwork <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              )}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {quotes.length > SHOWN && (
      <button type="button" class="btn btn-ghost more-quotes" aria-expanded="false" data-more-quotes>
        More feedback ({quotes.length - SHOWN})
      </button>
    )}
  </div>
</section>

<style>
  .feedback { padding-block: var(--section); }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; align-items: start; }
  @media (min-width: 48rem) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .cards { grid-template-columns: repeat(3, 1fr); } }

  figure { margin: 0; }
  .card {
    display: grid; gap: 1rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    border-radius: var(--radius-media); background: #fff; border: 1px solid var(--line);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease;
  }
  @media (hover: hover) {
    .card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px -24px rgb(36 16 24 / 0.45); }
    .card:hover .mark { transform: translateY(-3px) rotate(-6deg); }
  }
  .mark {
    font-family: var(--font-serif); font-size: 3.5rem; line-height: 0.6; height: 1.5rem;
    color: var(--wine); transition: transform 0.35s ease; transform-origin: left bottom;
  }

  blockquote { margin: 0; }
  .quote p { margin: 0; color: var(--ink); line-height: 1.6; }
  /* Long quotes start at 6 lines and fade out; "Read more" opens the rest */
  .quote.folded {
    max-height: calc(1.6em * 6); overflow: hidden; position: relative;
    transition: max-height 0.5s ease;
  }
  .quote.folded::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 2.5em;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), #fff);
    transition: opacity 0.3s ease;
  }
  .quote.folded.open { max-height: 40em; }
  .quote.folded.open::after { opacity: 0; }
  .more {
    justify-self: start; min-height: 2.75rem; padding: 0;
    background: none; border: 0; cursor: pointer;
    font: inherit; font-size: var(--fs-small); font-weight: 600; color: var(--wine);
    text-decoration: underline; text-underline-offset: 0.2em;
  }

  figcaption {
    display: grid; gap: 0.15rem; margin-top: 0.5rem; padding-top: 1rem;
    border-top: 1px solid var(--line); font-size: var(--fs-small);
  }
  figcaption strong { font-weight: 700; color: var(--ink); }
  figcaption span { color: var(--text-muted); }
  figcaption a { color: var(--wine); }
  .cards .extra { display: none; }
  .cards.all .extra { display: block; }
  .more-quotes { display: flex; width: fit-content; margin: 2rem auto 0; }
  .verified {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.35rem;
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); background: var(--green-soft); color: var(--green);
    font-size: var(--fs-label); font-weight: 700; text-decoration: none;
  }
</style>

<script>
  const moreQuotes = document.querySelector<HTMLButtonElement>('[data-more-quotes]');
  moreQuotes?.addEventListener('click', () => {
    const list = document.querySelector('#feedback .cards');
    const open = !list?.classList.contains('all');
    list?.classList.toggle('all', open);
    moreQuotes.setAttribute('aria-expanded', String(open));
    moreQuotes.textContent = open ? 'Show less' : `More feedback (${list?.querySelectorAll('.extra').length ?? ''})`;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-more-quote]').forEach((btn) => {
    const quote = document.getElementById(btn.getAttribute('aria-controls')!);
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show less' : 'Read more';
      quote?.classList.toggle('open', open);
    });
  });
</script>
