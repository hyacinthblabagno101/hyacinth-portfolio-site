---
/**
 * Client feedback, word for word. Text: "testimonials" in src/data/proof.json (order there = order here).
 * - A staggered grid (masonry columns): quote cards, each tagged with the role I had with that client (matched by company
 *   name in src/data/experience.json), with three of my videos for those same brands mixed in.
 * - Each quote starts as an excerpt that ends at a sentence boundary; "Read more" (aria-expanded) shows the rest.
 *   Without JavaScript every quote shows in full.
 * - Cards fade in one after another as they scroll into view (not with reduced motion).
 * - "Verified on Upwork" shows only on reviews that link to their Upwork source (a "url" in proof.json).
 *   TODO(hyacinth): confirm which reviews are Upwork reviews; only add a url for those.
 */
import { proof, experience, showcase } from '../lib/data';
import { viewerEntry } from '../lib/showcaseMedia';
import { posterFor } from '../lib/cloudinary';

const LIMIT = 190;
const roles = [...experience.professional, ...experience.additional].map((r) => ({
  // "Moname (Epic Tales & Rabble)" -> "Moname"; then the first two words, to match "Founder & CEO, Proper Ecom" etc.
  key: r.company.replace(/\(.*?\)/g, '').trim().split(/\s+/).slice(0, 2).join(' ').replace(/&$/, '').trim(),
  role: r.role,
}));
const roleFor = (who: string) => roles.find((r) => r.key && who.toLowerCase().includes(r.key.toLowerCase()))?.role;

const quotes = proof.testimonials.map((t, i) => {
  const sentences = t.quote.split(/(?<=[.!?])\s+/);
  let excerpt = sentences[0];
  let k = 1;
  while (k < sentences.length && (excerpt + ' ' + sentences[k]).length <= LIMIT) excerpt += ' ' + sentences[k++];
  return { kind: 'quote' as const, ...t, id: `quote-${i + 1}`, excerpt, rest: sentences.slice(k).join(' '), tag: roleFor(t.role) };
});

// Three videos for brands these clients run, placed between the quotes
const items = showcase.flatMap((c) => c.items);
const vids = ['reel-hs-bills', 'reel-wc-founder-bags', 'reel-rb-patches']
  .map((id) => items.find((i) => i.id === id))
  .filter((i): i is (typeof items)[number] => !!i)
  .map((i) => ({ kind: 'video' as const, id: i.id, entry: viewerEntry(i), poster: posterFor({ id: i.media }, 480, '4:5') }));
const cells: (typeof quotes[number] | typeof vids[number])[] = [];
quotes.forEach((q, i) => {
  cells.push(q);
  if (i % 2 === 0 && vids[i / 2]) cells.push(vids[i / 2]);
});
---

<section id="feedback" class="feedback band-dark" aria-labelledby="feedback-title">
  <div class="wrap">
    <header class="section-head reveal">
      <div class="head-title"><p class="kicker">Testimonials</p><h2 id="feedback-title">Client <em>feedback</em></h2></div>
      <p class="lede">A few words from brands I've worked with directly.</p>
    </header>

    <ul class="wall" role="list" data-viewer-list>
      {cells.map((c, n) => (
        <li class="reveal" style={`--delay: ${(n % 3) * 90}ms`}>
          {c.kind === 'quote' ? (
            <figure class="q">
              {c.tag && <p class="tag">{c.tag}</p>}
              <blockquote class="quote">
                <p>
                  <span class="mark" aria-hidden="true">&ldquo;</span>{c.excerpt}
                  {c.rest && <span id={c.id} class="rest" data-rest> {c.rest}</span>}
                </p>
              </blockquote>
              {c.rest && (
                <button type="button" class="btn btn--link more" aria-expanded="false" aria-controls={c.id} data-more-quote>
                  Read more <span class="visually-hidden">from {c.name}</span>
                </button>
              )}
              <figcaption>
                <strong>{c.name}</strong>
                <span>{c.role}</span>
                {c.url && (
                  <a class="verified" href={c.url} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" /></svg>
                    Verified on Upwork <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
              </figcaption>
            </figure>
          ) : (
            <a class="tile-link vid lift" href={c.entry.full} data-id={c.id}>
              <img src={c.poster} alt={c.entry.alt} width="480" height="600" loading="lazy" decoding="async" />
              <span class="vid-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
              {c.entry.brand && <span class="vid-name" aria-hidden="true">{c.entry.brand}</span>}
              <span class="visually-hidden">Play video: {c.entry.title}{c.entry.brand ? `, ${c.entry.brand}` : ''}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .feedback { padding-block: var(--section); }

  /* Staggered grid: CSS columns, so cards of different heights sit snugly */
  .wall { list-style: none; margin: 0; padding: 0; columns: 1; column-gap: 1rem; }
  @media (min-width: 40rem) { .wall { columns: 2; } }
  @media (min-width: 64rem) { .wall { columns: 3; column-gap: 1.25rem; } }
  .wall > li { break-inside: avoid; margin-bottom: 1rem; }
  @media (min-width: 64rem) { .wall > li { margin-bottom: 1.25rem; } }

  .q {
    margin: 0; display: grid; gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.6rem); border-radius: var(--radius-panel);
    background: var(--paper); color: var(--ink);
    --muted: #715d58; --rule: #e3dccf; --focus: var(--ink); --link: var(--ink); --text: var(--ink); --bg: var(--paper);
  }
  /* What I did for this client, like the service tag on each review in the reference */
  .tag { font-size: var(--fs-small); font-weight: 700; line-height: 1.3; }
  blockquote { margin: 0; }
  .quote p { margin: 0; color: var(--ink); line-height: 1.6; max-width: none; }
  .mark { font-family: var(--font-serif); font-size: 1.6em; line-height: 0; vertical-align: -0.3em; margin-right: 0.15em; color: var(--accent); }
  .more { justify-self: start; }
  figcaption { display: grid; gap: 0.15rem; padding-top: 0.9rem; border-top: 1px solid var(--rule); font-size: var(--fs-small); }
  figcaption strong { font-weight: 600; color: var(--ink); }
  figcaption span { color: var(--muted); }
  .verified {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.4rem;
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); background: var(--surface); color: var(--ink);
    font-size: var(--fs-label); font-weight: 600; text-decoration: none;
  }
  .verified:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }

  /* Work videos between the quotes */
  .vid { position: relative; display: block; overflow: hidden; border-radius: var(--radius-panel); aspect-ratio: 4 / 5; background: rgb(255 255 240 / 0.08); }
  .vid img { width: 100%; height: 100%; object-fit: cover; }
  .vid-play {
    position: absolute; top: 0.75rem; right: 0.75rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border-radius: 50%; background: var(--accent); color: var(--ink);
  }
  .vid-name {
    position: absolute; left: 0.75rem; bottom: 0.75rem; padding: 0.2rem 0.6rem; border-radius: var(--radius-pill);
    background: rgb(52 23 23 / 0.6); color: var(--paper); font-size: var(--fs-small); font-weight: 600; backdrop-filter: blur(4px);
  }
  .vid:focus-visible { outline: 3px solid var(--paper); outline-offset: 3px; }
</style>

<script>
  // Quotes start as excerpts once JavaScript runs; "Read more" shows the rest
  document.querySelectorAll<HTMLElement>('#feedback [data-rest]').forEach((r) => (r.hidden = true));
  document.querySelectorAll<HTMLButtonElement>('#feedback [data-more-quote]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      const rest = document.getElementById(btn.getAttribute('aria-controls')!);
      if (rest) rest.hidden = !open;
      btn.firstChild!.textContent = open ? 'Show less ' : 'Read more ';
    });
  });
</script>
