---
/**
 * Client feedback, word for word. Text lives in "testimonials" in src/data/proof.json (order there = order here).
 * - Desktop: a fixed grid of 3 reviews with matching card heights; "Show more reviews" adds the rest (no auto-carousel).
 *   Phones: the same cards stacked.
 * - Each card shows an excerpt that ends at a sentence boundary; "Read more" (aria-expanded) shows the full quote.
 * - The name and role sit directly under each quote.
 * - "Verified on Upwork" shows only on reviews that link to their Upwork source (a "url" in proof.json).
 *   TODO(hyacinth): confirm which reviews are Upwork reviews; only add a url for those.
 */
import { proof } from '../lib/data';

const SHOWN = 3;
const LIMIT = 190; // characters; the excerpt takes whole sentences up to about this length

const quotes = proof.testimonials.map((t, i) => {
  const sentences = t.quote.split(/(?<=[.!?])\s+/);
  let excerpt = sentences[0];
  let k = 1;
  while (k < sentences.length && (excerpt + ' ' + sentences[k]).length <= LIMIT) excerpt += ' ' + sentences[k++];
  const rest = sentences.slice(k).join(' ');
  return { ...t, id: `quote-${i + 1}`, excerpt, rest, extra: i >= SHOWN };
});
---

<section id="feedback" class="feedback band-dark" aria-labelledby="feedback-title">
  <div class="wrap">
    <header class="section-head reveal">
      <h2 id="feedback-title">Client <em>feedback</em></h2>
      <p class="lede">A few words from brands I've worked with directly.</p>
    </header>

    <ul class="cards" role="list" data-cards>
      {quotes.map((t) => (
        <li class:list={['reveal', { extra: t.extra }]}>
          <figure class="card">
            <blockquote class="quote">
              <p>
                <span class="mark" aria-hidden="true">&ldquo;</span>{t.excerpt}
                {t.rest && <span id={t.id} class="rest" data-rest> {t.rest}</span>}
              </p>
            </blockquote>
            {t.rest && (
              <button type="button" class="btn btn--link more" aria-expanded="false" aria-controls={t.id} data-more-quote>
                Read more <span class="visually-hidden">from {t.name}</span>
              </button>
            )}
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.role}</span>
              {t.url && (
                <a class="verified" href={t.url} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" /></svg>
                  Verified on Upwork <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              )}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {quotes.length > SHOWN && (
      <button type="button" class="btn btn--secondary show-more" aria-expanded="false" data-more-quotes>
        Show {quotes.length - SHOWN} more reviews
      </button>
    )}
  </div>
</section>

<style>
  .feedback { padding-block: var(--section); }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; align-items: stretch; }
  @media (min-width: 48rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; } }
  .cards > li { display: flex; }
  /* Without JavaScript every review and every full quote shows */
  :global(html.js) .cards > li.extra { display: none; }
  :global(html.js) .cards.all > li.extra { display: flex; }
  :global(html:not(.js)) .more, :global(html:not(.js)) .show-more { display: none; }

  figure { margin: 0; }
  /* Light cards on the dark band: they use the light-section colors */
  .card {
    flex: 1; display: flex; flex-direction: column; gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-panel); background: var(--paper); color: var(--ink);
    --muted: #715d58; --rule: #e3dccf; --focus: var(--ink); --link: var(--ink); --text: var(--ink); --bg: var(--paper);
  }
  blockquote { margin: 0; }
  .quote p { margin: 0; color: var(--ink); line-height: 1.6; max-width: none; }
  .mark { font-family: var(--font-serif); font-size: 1.6em; line-height: 0; vertical-align: -0.3em; margin-right: 0.15em; color: var(--ink); }
  .more { align-self: flex-start; }

  figcaption {
    display: grid; gap: 0.15rem; margin-top: auto; padding-top: 1rem;
    border-top: 1px solid var(--rule); font-size: var(--fs-small);
  }
  figcaption strong { font-weight: 600; color: var(--ink); }
  figcaption span { color: var(--muted); }
  .verified {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.4rem;
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); background: var(--surface); color: var(--ink);
    font-size: var(--fs-label); font-weight: 600; text-decoration: none;
  }
  .verified:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .show-more { display: flex; width: fit-content; margin: 2rem auto 0; }
</style>

<script>
  // Quotes start as excerpts once JavaScript runs; "Read more" shows the rest
  document.querySelectorAll<HTMLElement>('[data-rest]').forEach((r) => (r.hidden = true));
  document.querySelectorAll<HTMLButtonElement>('[data-more-quote]').forEach((btn) => {
    const rest = document.getElementById(btn.getAttribute('aria-controls')!);
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      if (rest) rest.hidden = !open;
      btn.firstChild!.textContent = open ? 'Show less ' : 'Read more ';
    });
  });

  // "Show more reviews" adds the rest of the cards and moves focus to the first new one
  const moreQuotes = document.querySelector<HTMLButtonElement>('[data-more-quotes]');
  moreQuotes?.addEventListener('click', () => {
    const list = document.querySelector<HTMLElement>('[data-cards]');
    if (!list) return;
    const open = !list.classList.contains('all');
    list.classList.toggle('all', open);
    moreQuotes.setAttribute('aria-expanded', String(open));
    moreQuotes.textContent = open ? 'Show fewer reviews' : `Show ${list.querySelectorAll('.extra').length} more reviews`;
    if (open) list.querySelector<HTMLElement>('.extra .card')?.setAttribute('tabindex', '-1');
    if (open) list.querySelector<HTMLElement>('.extra .card')?.focus();
  });
</script>
