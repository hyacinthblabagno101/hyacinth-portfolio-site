---
/**
 * Client feedback, word for word. Text lives in "testimonials" in src/data/proof.json (order there = order here).
 * - A sliding row: three reviews at a time, all the same size (two on tablets, one on phones), each tagged with the
 *   role I had with that client (matched by company name in src/data/experience.json).
 * - Every 5 seconds the row glides on by one review, and loops back to the start without a jump. It pauses on hover,
 *   keyboard focus, touch, while a full quote is open, and when off screen. No Pause button or timer line, by choice.
 *   With reduced motion it never moves on its own. Arrows, swipe and the dots also move it.
 * - Each quote starts as an excerpt that ends at a sentence boundary; "Read more" (aria-expanded) shows the rest.
 * - Without JavaScript every review shows in full, in a grid.
 * - "Verified on Upwork" shows only on reviews that link to their Upwork source (a "url" in proof.json).
 *   TODO(hyacinth): confirm which reviews are Upwork reviews; only add a url for those.
 */
import { proof, experience } from '../lib/data';

const LIMIT = 190; // characters; the excerpt takes whole sentences up to about this length
const roles = [...experience.professional, ...experience.additional].map((r) => ({
  // Brackets are dropped ("Name (Brand)" -> "Name"); then the first two words, to match "Founder & CEO, Proper Ecom" etc.
  key: r.company.replace(/\(.*?\)/g, '').trim().split(/\s+/).slice(0, 2).join(' ').replace(/&$/, '').trim(),
  role: r.role,
}));
const roleFor = (who: string) => roles.find((r) => r.key && who.toLowerCase().includes(r.key.toLowerCase()))?.role;

const quotes = proof.testimonials.map((t, i) => {
  const sentences = t.quote.split(/(?<=[.!?])\s+/);
  let excerpt = sentences[0];
  let k = 1;
  while (k < sentences.length && (excerpt + ' ' + sentences[k]).length <= LIMIT) excerpt += ' ' + sentences[k++];
  return { ...t, id: `quote-${i + 1}`, excerpt, rest: sentences.slice(k).join(' '), tag: roleFor(t.role) };
});
---

<section id="feedback" class="feedback band-dark" aria-labelledby="feedback-title" aria-roledescription="carousel" data-feedback>
  <div class="wrap">
    <header class="section-head reveal">
      <div class="head-title"><p class="kicker">Testimonials</p><h2 id="feedback-title">Client <em>feedback</em></h2></div>
      <p class="lede">A few words from brands I've worked with directly.</p>
    </header>

    <div class="viewport" data-viewport>
    <div class="stage" data-stage>
      {quotes.map((t, i) => (
        <figure class="q" data-q={i} aria-roledescription="slide" aria-label={`${i + 1} of ${quotes.length}`}>
          {t.tag && <p class="tag">{t.tag}</p>}
          <blockquote class="quote">
            <p>
              <span class="mark" aria-hidden="true">&ldquo;</span>{t.excerpt}
              {t.rest && <span id={t.id} class="rest" data-rest> {t.rest}</span>}
            </p>
          </blockquote>
          {t.rest && (
            <button type="button" class="btn btn--link more" aria-expanded="false" aria-controls={t.id} data-more-quote>
              Read more <span class="visually-hidden">from {t.name}</span>
            </button>
          )}
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.role}</span>
            {t.url && (
              <a class="verified" href={t.url} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" /></svg>
                Verified on Upwork <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )}
          </figcaption>
        </figure>
      ))}
    </div>

    </div>
    <div class="controls">
      <p class="dots" aria-hidden="true" data-dots></p>
      <p class="visually-hidden" aria-live="polite" data-status></p>
      <div class="arrows">
        <button type="button" class="arrow" data-prev aria-label="Previous review">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </button>
        <button type="button" class="arrow" data-next aria-label="Next review">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .feedback { padding-block: var(--section); }

  /* Equal columns; every card in a row is the same height. Without JavaScript all reviews show here in full. */
  .stage { display: grid; gap: 1rem; align-items: stretch; }
  @media (min-width: 48rem) { .stage { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .stage { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; } }

  .q {
    margin: 0; display: flex; flex-direction: column; gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); border-radius: var(--radius-panel);
    background: var(--paper); color: var(--ink);
    --muted: #715d58; --rule: #e5e2dd; --focus: var(--ink); --link: var(--ink); --text: var(--ink); --bg: var(--paper);
  }
  /* What I did for this client */
  .tag { font-size: var(--fs-small); font-weight: 700; line-height: 1.3; }
  blockquote { margin: 0; }
  .quote p { margin: 0; color: var(--ink); line-height: 1.6; max-width: none; }
  .mark { font-family: var(--font-serif); font-size: 1.6em; line-height: 0; vertical-align: -0.3em; margin-right: 0.15em; color: var(--accent); }
  .more { align-self: flex-start; }
  figcaption { display: grid; gap: 0.15rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--rule); font-size: var(--fs-small); }
  figcaption strong { font-weight: 600; color: var(--ink); }
  figcaption span { color: var(--muted); }
  .verified {
    justify-self: start; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.4rem;
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill); background: var(--surface); color: var(--ink);
    font-size: var(--fs-label); font-weight: 600; text-decoration: none;
  }

  /* With JavaScript: one row that slides. Each card is a third of the row (half on tablets, all of it on phones). */
  .controls { display: none; }
  :global(html.js) .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  :global(html.js) .viewport { overflow: hidden; margin: -4px; padding: 4px; }
  :global(html.js) .stage { position: relative; display: flex; gap: var(--gap); --gap: 1rem; --per: 1; }
  @media (min-width: 48rem) { :global(html.js) .stage { --per: 2; } }
  @media (min-width: 64rem) { :global(html.js) .stage { --per: 3; --gap: 1.25rem; } }
  :global(html.js) .stage > .q { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); }
  .stage.glide { transition: transform 700ms var(--ease); }

  /* Each dot is a 24px tap area with the small visible dot inside it */
  .dots { display: flex; gap: 0; }
  .dots :global(button) { display: grid; place-items: center; min-width: 24px; height: 24px; padding: 0 0.2rem; border: 0; background: none; cursor: pointer; border-radius: var(--radius-pill); }
  .dots :global(button)::before { content: ''; display: block; width: 0.5rem; height: 0.5rem; border-radius: var(--radius-pill); background: rgb(255 255 255 / 0.3); transition: width var(--t-move) var(--ease), background var(--t-move) var(--ease); }
  .dots :global(button.on)::before { width: 1.75rem; background: var(--paper); }
  .arrows { display: flex; gap: 0.5rem; align-items: center; }
  .arrow {
    display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.6); background: transparent; color: var(--paper); cursor: pointer;
    transition: background-color var(--t-ui) var(--ease), color var(--t-ui) var(--ease);
  }
  .arrow:hover { background: var(--paper); color: var(--ink); }
  .arrow:focus-visible, .dots :global(button:focus-visible) { outline: 3px solid var(--paper); outline-offset: 3px; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-feedback]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');
  const slides = [...(stage?.querySelectorAll<HTMLElement>('[data-q]') ?? [])];
  if (root && stage && slides.length) {
    const n = slides.length;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dots = root.querySelector<HTMLElement>('[data-dots]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const DELAY = 5000;
    let index = 0; // position of the first card in view (n..n+2 are copies of the first three, for the loop)
    let held = 0; // hover, focus, touch or an open quote
    let onScreen = false;
    let timer = 0;

    // Copies of the first three after the last, so the row loops forward without jumping back
    const copies = slides.slice(0, 3).map((s) => {
      const c = s.cloneNode(true) as HTMLElement;
      c.removeAttribute('data-q');
      c.setAttribute('aria-hidden', 'true');
      c.inert = true;
      c.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      c.querySelectorAll('[aria-controls]').forEach((el) => el.removeAttribute('aria-controls'));
      stage.append(c);
      return c;
    });
    const all = [...slides, ...copies];
    const per = () => Number(getComputedStyle(stage).getPropertyValue('--per')) || 1;

    // Quotes start as excerpts; "Read more" shows the rest of that quote
    const setOpen = (fig: HTMLElement, open: boolean) => {
      const btn = fig.querySelector<HTMLButtonElement>('[data-more-quote]');
      const rest = fig.querySelector<HTMLElement>('[data-rest]');
      if (!btn || !rest) return;
      if ((btn.getAttribute('aria-expanded') === 'true') === open) return;
      btn.setAttribute('aria-expanded', String(open));
      rest.hidden = !open;
      btn.firstChild!.textContent = open ? 'Show less ' : 'Read more ';
      hold(open ? 1 : -1); // reading a full quote stops the auto-advance
    };
    all.forEach((fig) => {
      fig.querySelectorAll<HTMLElement>('[data-rest]').forEach((r) => (r.hidden = true));
      fig.querySelector<HTMLButtonElement>('[data-more-quote]')?.addEventListener('click', (e) => {
        setOpen(fig, (e.currentTarget as HTMLElement).getAttribute('aria-expanded') !== 'true');
      });
    });

    dots.replaceChildren(...slides.map((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Show review ${i + 1}`);
      b.addEventListener('click', () => go(i));
      return b;
    }));
    dots.removeAttribute('aria-hidden');

    function place(animate: boolean) {
      stage!.classList.toggle('glide', animate && !calm);
      stage!.style.transform = `translateX(${-all[index].offsetLeft}px)`;
      const shown = per();
      slides.forEach((s, i) => {
        const pos = (i - (index % n) + n) % n;
        const visible = pos < shown;
        s.setAttribute('aria-hidden', String(!visible));
        s.querySelectorAll<HTMLElement>('a, button').forEach((el) => (el.tabIndex = visible ? 0 : -1));
      });
      [...dots.children].forEach((d, i) => d.classList.toggle('on', i === index % n));
      status.textContent = `Reviews ${(index % n) + 1} to ${((index + shown - 1) % n) + 1} of ${n}`;
      schedule();
    }
    function go(i: number, animate = true) {
      all.forEach((f) => setOpen(f, false)); // collapse open quotes before moving
      if (i < 0) {
        // Going back from the first: jump to its copy at the end, then glide back one
        index = n;
        place(false);
        void stage!.offsetWidth;
        i = n - 1;
      }
      index = i;
      place(animate);
      // After gliding onto the copies, jump back to the real first cards (they look the same).
      // A timer rather than transitionend, which doesn't always fire (background tabs, interrupted glides).
      window.clearTimeout(snap);
      if (index >= n) snap = window.setTimeout(() => { if (index >= n) { index -= n; place(false); } }, animate && !calm ? 750 : 0);
    }
    let snap = 0;
    function schedule() {
      window.clearTimeout(timer);
      if (calm || held || !onScreen) return;
      timer = window.setTimeout(() => go(index + 1), DELAY);
    }
    function hold(d: number) { held = Math.max(0, held + d); schedule(); }

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    viewport.addEventListener('mouseenter', () => hold(1));
    viewport.addEventListener('mouseleave', () => hold(-1));
    root.addEventListener('focusin', () => hold(1));
    root.addEventListener('focusout', () => hold(-1));
    // Swipe on touch screens
    let x0 = 0;
    viewport.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; hold(1); }, { passive: true });
    viewport.addEventListener('touchend', (e) => {
      hold(-1);
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
    window.addEventListener('resize', () => place(false));
    new IntersectionObserver((e) => { onScreen = e[0].isIntersecting; schedule(); }, { threshold: 0.3 }).observe(root);
    place(false);
  }
</script>
