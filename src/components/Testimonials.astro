---
/**
 * Client feedback, word for word. Text lives in "testimonials" in src/data/proof.json.
 * The first quote is shown large; the rest sit in a grid below it.
 */
import { proof } from '../lib/data';

const [lead, ...rest] = proof.testimonials;
---

<section id="feedback" class="feedback" aria-labelledby="feedback-title">
  <div class="wrap">
    <header class="head reveal">
      <h2 id="feedback-title">Client <em>feedback</em></h2>
    </header>

    {
      lead && (
        <figure class="lead reveal">
          <blockquote>
            <p>{lead.quote}</p>
          </blockquote>
          <figcaption>
            <strong>{lead.name}</strong>
            <span>{lead.role}</span>
          </figcaption>
        </figure>
      )
    }

    <ul class="grid" role="list">
      {
        rest.map((t, i) => (
          <li class="reveal" style={`--delay: ${i * 80}ms`}>
            <figure class="card">
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
              <figcaption>
                <strong>{t.name}</strong>
                <span>
                  {t.url ? (
                    <a href={t.url} target="_blank" rel="noopener">
                      {t.role}, on Upwork <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  ) : (
                    t.role
                  )}
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feedback { padding-block: var(--section); }
  .head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }

  blockquote { margin: 0; }
  figure { margin: 0; }
  figcaption { display: grid; gap: 0.1rem; font-size: var(--fs-small); }
  figcaption strong { font-weight: 600; }
  figcaption span { color: var(--text-muted); }
  figcaption a { color: var(--wine); }

  .lead { display: grid; gap: 1.5rem; padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  /* Pull quote: large enough to lead, short enough lines to read (about 60 characters) */
  .lead p {
    margin: 0; max-width: 60ch;
    font-family: var(--font-serif);
    font-size: var(--fs-lead);
    line-height: 1.55; color: var(--ink);
  }
  .lead p::before { content: '\201C'; color: var(--wine); }
  .lead p::after { content: '\201D'; color: var(--wine); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 3rem; border-top: 1px solid var(--line); }
  @media (min-width: 48rem) { .grid { grid-template-columns: 1fr 1fr; } }
  .grid li { display: flex; border-bottom: 1px solid var(--line); }
  .card { flex: 1; display: grid; gap: 1rem; align-content: space-between; padding: 1.5rem 0; }
  .card p { margin: 0; color: var(--ink); }
</style>
