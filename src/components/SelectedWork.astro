---
/**
 * Brand logos and "Selected work".
 * - Logos: every brand in src/data/showcase.json, in one band that drifts sideways and loops.
 *   Hover pauses it; with reduced motion it stands still and wraps onto lines instead.
 * - Selected work: one card per client, biggest collections first: the logo, the types of content and my role,
 *   on a solid card (no cover pictures). Brands I handled through a client (the "groups" in showcase.json,
 *   e.g. Expert Biotics through Proper Ecom) sit inside that client's card.
 *   Selecting a card opens the whole collection in the viewer (the viewer lives in Showcase.astro).
 */
import { showcase, roleFor, brandGroups, groupOf } from '../lib/data';
import { viewerEntry } from '../lib/showcaseMedia';

const CARDS = 9; // 3 x 3 grid

const labelOf = new Map(showcase.map((c) => [c.key, c.label]));
const items = showcase.flatMap((c) => c.items);

const byBrand = new Map<string, typeof items>();
items.forEach((i) => { if (i.brand) byBrand.set(i.brand, [...(byBrand.get(i.brand) ?? []), i]); });
const allBrands = [...byBrand.keys()].sort((a, b) => a.localeCompare(b));

/**
 * Logos live in public/logos (white, trimmed, 160px tall WebP). Brands without a logo file show their name.
 * Width is set from each logo's shape so wide wordmarks and square marks look about the same size.
 */
const logos: Record<string, { file: string; w: number; h: number }> = {
  'Epic Tales': { file: 'epictales', w: 597, h: 160 },
  'Expert Biotics': { file: 'expertbiotics', w: 570, h: 160 },
  'Hair Solution Nails and Spa': { file: 'hairsolution', w: 694, h: 160 },
  'Hyacinth Gadgets': { file: 'hyacinthgadgets', w: 207, h: 160 },
  'iLuxe Aesthetic Center': { file: 'iluxe', w: 128, h: 160 },
  'Proper Ecom': { file: 'properecom', w: 780, h: 160 },
  'Rabble': { file: 'rabble', w: 496, h: 160 },
  'Stacked Science': { file: 'stackedscience', w: 370, h: 160 },
  'Style State': { file: 'stylestate', w: 2063, h: 160 },
  'Suezicu': { file: 'suezicu', w: 1281, h: 160 },
  'T-James Sporty Bar': { file: 'tjamessportybar', w: 163, h: 160 },
  'Uncle Scientist': { file: 'unclescientist', w: 364, h: 160 },
  'Winnie & Co.': { file: 'winnieandco', w: 1254, h: 160 },
};
const logoSize = (l: { w: number; h: number }, scale = 62, cap = 190) => {
  const ratio = l.w / l.h;
  const width = Math.round(Math.min(cap, scale * Math.sqrt(ratio))); // equal visual area, capped for long wordmarks
  return { width, height: Math.round(width / ratio) };
};
const band = allBrands.map((name) => {
  const l = logos[name];
  return l ? { name, src: `/logos/${l.file}.webp`, ...logoSize(l) } : { name };
});

// Cards: brands handled through a client are counted under that client
const byClient = new Map<string, typeof items>();
byBrand.forEach((list, brand) => {
  const client = groupOf(brand) ?? brand;
  byClient.set(client, [...(byClient.get(client) ?? []), ...list]);
});

const cards = [...byClient.entries()]
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, CARDS)
  .map(([client, list]) => {
    const ordered = [
      ...list.filter((i) => i.board),
      ...list.filter((i) => !i.board && i.kind === 'image'),
      ...list.filter((i) => i.kind === 'video'),
    ];
    const logo = logos[client];
    return {
      client,
      logo: logo ? { src: `/logos/${logo.file}.webp`, ...logoSize(logo, 60, 170) } : undefined,
      types: [...new Set(list.map((i) => i.category))].map((k) => labelOf.get(k) ?? k),
      role: roleFor(client),
      group: brandGroups[client],
      items: ordered.map((i) => i.id).join(','), // ids; the viewer looks them up in one shared list
      first: viewerEntry(ordered[0]),
    };
  });
---

<section class="strip band-dark" aria-labelledby="brands-title">
  <h2 id="brands-title" class="strip-title">Brands I've made content for</h2>
  <div class="marquee">
    <ul role="list" class="logos">
      {band.map((b) => (
        'src' in b
          ? <li class="logo" style={`--w: ${b.width}px`}><img src={b.src} alt={b.name} width={b.width} height={b.height} decoding="async" /></li>
          : <li class="name">{b.name}</li>
      ))}
    </ul>
    {/* A copy so the band loops without a gap; hidden from screen readers */}
    <ul role="list" class="logos copy" aria-hidden="true">
      {band.map((b) => ('src' in b ? <li class="logo" style={`--w: ${b.width}px`}><img src={b.src} alt="" width={b.width} height={b.height} decoding="async" /></li> : <li class="name">{b.name}</li>))}
    </ul>
  </div>
</section>

<section id="selected" class="selected" aria-labelledby="selected-title">
  <div class="wrap">
    <header class="top reveal">
      <h2 id="selected-title">Selected <em>work</em></h2>
      <a class="all" href="#work">Browse all work <span aria-hidden="true">&darr;</span></a>
    </header>

    <ul class="cards" role="list">
      {cards.map((c, n) => (
        <li class="reveal" style={`--delay: ${(n % 3) * 70}ms`}>
          <a class="tile-link card" href={c.first.full} data-items={c.items}>
            <span class="mark-wrap">
              {c.logo
                ? <img class="mark" src={c.logo.src} alt="" width={c.logo.width} height={c.logo.height} decoding="async" />
                : <span class="mark-text" aria-hidden="true">{c.client}</span>}
            </span>
            <span class="card-name">{c.client}</span>
            <span class="info">
              <span class="types">{c.types.join(' · ')}</span>
              {c.group && <span class="group">{c.group.note}: {c.group.brands.join(', ')}</span>}
              {c.role && <span class="role">{c.role}</span>}
              <span class="open" aria-hidden="true">View collection <span>&rarr;</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Logo band */
  .strip { background: var(--wine); padding-block: clamp(2.25rem, 1.75rem + 2vw, 3.25rem); overflow: hidden; }
  .strip-title {
    max-width: none; text-align: center; padding-inline: var(--gutter);
    font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; line-height: 1.4; text-transform: uppercase; color: var(--paper);
  }
  .marquee {
    display: flex; width: max-content; margin-top: 1.5rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .logos { list-style: none; margin: 0; padding: 0 clamp(1.5rem, 1rem + 2vw, 3rem) 0 0; display: flex; align-items: center; gap: clamp(2rem, 1.25rem + 3vw, 4rem); flex: none; }
  .logos .logo img { display: block; width: var(--w); max-width: none; height: auto; opacity: 0.9; }
  .logos .name { font-weight: 700; font-size: var(--fs-body); letter-spacing: -0.02em; text-transform: uppercase; color: var(--paper); white-space: nowrap; }
  @media (max-width: 40rem) { .logos .logo img { width: calc(var(--w) * 0.75); } }
  @media (prefers-reduced-motion: no-preference) {
    .marquee { animation: slide 45s linear infinite; }
    .strip:hover .marquee { animation-play-state: paused; }
    @keyframes slide { to { transform: translateX(-50%); } }
  }
  /* Reduced motion: one still, centered set that wraps onto lines */
  @media (prefers-reduced-motion: reduce) {
    .marquee { width: auto; justify-content: center; -webkit-mask-image: none; mask-image: none; padding-inline: var(--gutter); }
    .logos { flex-wrap: wrap; justify-content: center; padding: 0; row-gap: 1.25rem; }
    .logos.copy { display: none; }
  }

  /* Selected work */
  .selected { padding-block: var(--section) clamp(3rem, 2rem + 3vw, 4.5rem); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .all {
    display: inline-flex; gap: 0.4rem; align-items: center; min-height: 2.75rem;
    font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink);
  }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .cards { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }

  /* Solid cards: logo on top, details at the bottom. Hover lifts the card and warms it to wine. */
  .card {
    position: relative; display: grid; grid-template-rows: auto 1fr; gap: 2.5rem; height: 100%; min-height: 17rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--radius-media); background: var(--ink);
    color: var(--paper); text-decoration: none;
    transition: background 0.35s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease;
  }
  @media (max-width: 39.99rem) { .card { min-height: 0; gap: 2rem; } }
  .card:hover, .card:focus-visible {
    background: var(--wine); transform: translateY(-4px);
    box-shadow: 0 18px 36px -20px rgb(34 21 22 / 0.55);
  }
  .card:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .mark-wrap { display: flex; align-items: center; min-height: 3.5rem; }
  .mark { display: block; height: auto; max-width: 75%; max-height: 4.5rem; width: auto; opacity: 0.92; transition: transform 0.4s ease, opacity 0.3s ease; transform-origin: left center; }
  .card:hover .mark, .card:focus-visible .mark { opacity: 1; transform: scale(1.04); }
  .mark-text { font-weight: 700; font-size: var(--fs-h3); letter-spacing: -0.03em; text-transform: uppercase; line-height: 1; }
  .card-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } /* the logo shows it; kept for screen readers */

  .info { display: grid; gap: 0.45rem; align-content: end; justify-items: start; }
  .types { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rose); }
  .group { font-family: var(--font-serif); font-style: italic; font-size: var(--fs-small); color: var(--paper); }
  .role {
    font-size: var(--fs-small); color: var(--greige);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .open {
    display: inline-flex; gap: 0.4rem; align-items: center; margin-top: 0.4rem;
    font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--paper);
  }
  .open span { transition: transform 0.3s ease; }
  .card:hover .open span, .card:focus-visible .open span { transform: translateX(4px); }
</style>
