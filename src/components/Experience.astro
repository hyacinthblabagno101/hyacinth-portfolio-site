---
/**
 * Experience timeline from src/data/experience.json, in the order listed there.
 * Roles with confirmed: false only show while previewing. The first 3 are open; the rest fold away.
 */
import { roles } from '../lib/data';
import Role from './ExperienceRole.astro';

/** The most recent roles stay open; the rest fold behind "See all roles". */
const OPEN = 3;
const first = roles.slice(0, OPEN);
const rest = roles.slice(OPEN);
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="experience-title">Where I've <em>worked</em></h2>
      <p class="lede">Roles I've held, most recent first.</p>
    </header>

    <ol class="timeline" role="list">
      {first.map((r) => <Role r={r} />)}
    </ol>

    {
      rest.length > 0 && (
        <details class="more">
          <summary>
            <span>See all {roles.length} roles</span>
            <span class="plus" aria-hidden="true" />
          </summary>
          <ol class="timeline" role="list" start={first.length + 1}>
            {rest.map((r) => <Role r={r} />)}
          </ol>
        </details>
      )
    }
  </div>
</section>

<style>
  .experience { padding-block: var(--section); }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .more .timeline { margin-top: 0; }
  .timeline :global(.item) {
    display: grid;
    gap: 0.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
  /* Dates sit as a small label above the title (no side column), so roles without dates leave no gap */

  .timeline :global(.dates) { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--wine); }
  .timeline :global(.detail) { display: grid; gap: 0.6rem; max-width: 46rem; }
  .timeline :global(.org) { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .timeline :global(.org span) { color: var(--text-muted); }
  .timeline :global(.detail ul) { margin: 0.25rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.35rem; color: var(--text-muted); }

  /* "See all roles" disclosure, same style as the case study details */
  .more { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .more summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 3.25rem; cursor: pointer; list-style: none;
    font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink);
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { color: var(--wine); }
  .plus { position: relative; width: 0.9rem; height: 0.9rem; flex: none; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform 0.25s ease; }
  .plus::after { transform: rotate(90deg); }
  .more[open] .plus::after { transform: rotate(0deg); }
</style>
