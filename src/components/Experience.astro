---
/**
 * Experience, in three parts. All text: src/data/experience.json (from my Nov 2026 experience files).
 * 1. Professional experience: a list of roles on the left; hovering, focusing, or tapping one shows its history
 *    (overview, what I did, brands) in the panel on the right. On phones each role opens in place.
 * 2. Two panels side by side: Additional experience & projects (Blue) and Business background (Chocopie).
 *    Each shows a preview of names and opens a pop-up: the full list of projects (no dates), or the businesses
 * with the skills that carry over. Both pop-ups share one format (intro, then a grid of cards).
 */
import { experience } from '../lib/data';

const { professional, additional, businesses } = experience;
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="experience-title">Experience</h2>
      <p class="lede">Hover or tap a role to see what I did there.</p>
    </header>

    <h3 class="group-title">Professional experience</h3>
    <div class="pro" data-pro>
      <ol class="roles" role="list">
        {professional.map((r, i) => (
          <li>
            <button type="button" class:list={['role', { active: i === 0 }]} data-role={i} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`role-${i}`}>
              <span class="dates">{r.dates}</span>
              <span class="name">{r.company}</span>
              <span class="title">{r.role}</span>
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </button>
            <div class="detail" id={`role-${i}`} data-detail={i} hidden={i !== 0}>
              <p class="meta">{r.type} &middot; {r.industry}</p>
              <p class="summary">{r.summary}</p>
              <ul class="points">{r.points.map((p) => <li>{p}</li>)}</ul>
              <p class="brands"><span>Brands</span> {r.brands.join(' · ')}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="panel" aria-live="polite" data-panel></div>
    </div>

    <div class="more">
      <article class="tile tile-extra" aria-labelledby="extra-title">
        <h3 id="extra-title">Additional experience &amp; projects</h3>
        <p>{additional.length} more brands and projects I've supported.</p>
        <ul class="names" role="list">
          {additional.slice(0, 6).map((a) => <li>{a.company}</li>)}
          {additional.length > 6 && <li class="rest">+{additional.length - 6} more</li>}
        </ul>
        <button type="button" class="btn btn--secondary" data-exp-open="exp-extra" aria-haspopup="dialog">View all {additional.length}</button>
      </article>
      <article class="tile tile-biz" aria-labelledby="biz-title">
        <h3 id="biz-title">Business background</h3>
        <p>{businesses.intro}</p>
        <ul class="names" role="list">
          {businesses.list.map((b) => <li>{b.name}</li>)}
        </ul>
        <button type="button" class="btn btn--secondary" data-exp-open="exp-biz" aria-haspopup="dialog">View all {businesses.list.length}</button>
      </article>
    </div>

    <!-- Both pop-ups share one format: a short intro, then a grid of cards -->
    <dialog class="exp-pop" id="exp-extra" aria-labelledby="exp-extra-title">
      <header class="exp-head">
        <h3 id="exp-extra-title">Additional experience &amp; projects</h3>
        <button type="button" class="x" data-exp-close aria-label="Close">&times;</button>
      </header>
      <div class="exp-intro">
        <p>{additional.length} more brands and projects I've supported.</p>
      </div>
      <ul class="extra" role="list">
        {additional.map((a) => (
          <li>
            <strong>{a.company}</strong>
            <span class="extra-role">{a.role}</span>
            <span class="extra-note">{a.note}</span>
          </li>
        ))}
      </ul>
    </dialog>

    <dialog class="exp-pop" id="exp-biz" aria-labelledby="exp-biz-title">
      <header class="exp-head">
        <h3 id="exp-biz-title">Business background</h3>
        <button type="button" class="x" data-exp-close aria-label="Close">&times;</button>
      </header>
      <div class="exp-intro">
        <p>{businesses.intro}</p>
        <ul class="skills" role="list" aria-label="Skills that carry over">
          {businesses.skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <ul class="extra" role="list">
        {businesses.list.map((b) => (
          <li>
            <span class="extra-top"><strong>{b.name}</strong><span class="extra-when">{b.dates}</span></span>
            <span class="extra-role">{b.industry}</span>
            <span class="extra-note">{b.highlight}</span>
          </li>
        ))}
      </ul>
    </dialog>
  </div>
</section>

<style>
  .experience { padding-block: var(--section); }
  .group-title {
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) 0 1rem;
    font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink);
  }
  .group-title:first-of-type { margin-top: 0; }

  /* Professional: list + history panel */
  .pro { display: grid; gap: 1.5rem; }
  @media (min-width: 64rem) { .pro { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; } }
  .roles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .roles > li { border-bottom: 1px solid var(--rule); }
  .role {
    width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.2rem 1rem; align-items: center;
    padding: 1.1rem 0.75rem; background: none; border: 0; border-radius: var(--radius-media);
    font: inherit; color: var(--ink); text-align: left; cursor: pointer;
    transition: background 0.25s ease, padding 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .role:hover, .role.active { background: rgb(52 23 23 / 0.05); padding-left: 1.1rem; }
  .role .dates { grid-column: 1; font-size: var(--fs-small); color: var(--muted); }
  .role .name { grid-column: 1; font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .role .title { grid-column: 1; font-size: var(--fs-small); font-weight: 600; color: var(--ink); }
  .role .arrow { grid-column: 2; grid-row: 1 / span 3; font-size: 1.25rem; color: var(--ink); opacity: 0; transform: translateX(-6px); transition: opacity 0.25s ease, transform 0.25s ease; }
  .role:hover .arrow, .role.active .arrow { opacity: 1; transform: none; }

  .detail { display: grid; gap: 0.75rem; padding: 0.25rem 0.75rem 1.5rem; }
  .detail[hidden] { display: none; }
  .meta { font-size: var(--fs-small); color: var(--muted); }
  .summary { font-size: var(--fs-lead); line-height: 1.45; }
  .points { margin: 0; padding-left: 1.15rem; display: grid; gap: 0.45rem; color: var(--muted); }
  .brands { font-size: var(--fs-small); color: var(--muted); }
  .brands span { font-weight: 700; color: var(--ink); margin-right: 0.35rem; }

  /* Wide screens: details show in the panel on the right instead of under each row */
  .panel { display: none; }
  @media (min-width: 64rem) {
    .roles .detail { display: none; }
    .panel {
      display: block; position: sticky; top: 6rem;
      padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem); border-radius: var(--radius-panel);
      background: var(--ink); color: var(--paper);
      --muted: rgb(255 255 240 / 0.78); --ink: var(--paper);
    }
    .panel :global(.detail) { display: grid !important; padding: 0; animation: swap 0.35s ease; }
    @keyframes swap { from { opacity: 0; transform: translateY(8px); } }
    .panel :global(.points) { color: rgb(255 255 240 / 0.85); }
  }

  /* Two panels side by side: Additional (Blue) and Business background (Chocopie); each opens a pop-up */
  .more { display: grid; gap: 1rem; margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  @media (min-width: 48rem) { .more { grid-template-columns: 1fr 1fr; } }
  .tile {
    display: flex; flex-direction: column; align-items: flex-start; gap: 1rem;
    padding: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem); border-radius: var(--radius-panel);
  }
  .tile h3 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); letter-spacing: -0.02em; line-height: 1.15; color: inherit; }
  .tile > p { max-width: 46ch; }
  .tile .btn { margin-top: auto; }
  .tile-extra { background: var(--surface); color: var(--ink); }
  .tile-extra > p { color: var(--muted); }
  .tile-biz { background: var(--ink); color: var(--paper); }
  .tile-biz > p { color: rgb(255 255 240 / 0.8); }
  .names { list-style: none; margin: 0 0 0.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .names li { padding: 0.3rem 0.75rem; border-radius: var(--radius-pill); font-size: var(--fs-label); font-weight: 600; }
  .tile-extra .names li { background: var(--paper); }
  .tile-extra .names .rest { background: transparent; border: 1px dashed rgb(52 23 23 / 0.35); }
  .tile-biz .names li { background: rgb(255 255 240 / 0.12); color: var(--paper); }

  /* Pop-ups */
  .exp-pop {
    width: min(100vw - 1.5rem, 56rem); max-height: calc(100dvh - 1.5rem); padding: 0; border: 0;
    border-radius: var(--radius-panel); background: var(--paper); color: var(--ink);
  }
  .exp-pop[open] { animation: exp-pop-in 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes exp-pop-in { from { opacity: 0; transform: translateY(14px); } }
  .exp-pop::backdrop { background: rgb(52 23 23 / 0.72); backdrop-filter: blur(3px); }
  .exp-head {
    position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1rem clamp(1.25rem, 1rem + 1vw, 2rem); background: var(--paper); border-bottom: 1px solid var(--rule);
  }
  .exp-head h3 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem); letter-spacing: -0.02em; }
  .x {
    flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--rule); background: var(--paper);
    color: var(--ink); font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .x:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .extra { list-style: none; margin: 0; padding: clamp(1.25rem, 1rem + 1vw, 2rem); display: grid; gap: 0.75rem; }
  @media (min-width: 40rem) { .extra { grid-template-columns: repeat(2, 1fr); } }
  .extra li { display: grid; gap: 0.2rem; align-content: start; padding: 1rem 1.1rem; border: 1px solid var(--rule); border-radius: var(--radius-media); }
  .extra strong { font-weight: 700; }
  .extra-role { font-size: var(--fs-small); font-weight: 600; color: var(--ink); }
  .extra-note { font-size: var(--fs-small); color: var(--muted); }

  .exp-intro { display: grid; gap: 0.9rem; padding: clamp(1.25rem, 1rem + 1vw, 2rem) clamp(1.25rem, 1rem + 1vw, 2rem) 0; max-width: 62ch; }
  .exp-intro p { color: var(--muted); }
  .skills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .skills li { padding: 0.3rem 0.75rem; border-radius: var(--radius-pill); background: var(--surface); font-size: var(--fs-label); font-weight: 600; }
  .extra-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .extra-when { flex: none; font-size: var(--fs-label); font-weight: 600; color: var(--muted); }
</style>

<script>
  // Professional roles: hover or focus (wide screens) or tap (any screen) shows that role's history
  const pro = document.querySelector<HTMLElement>('[data-pro]');
  if (pro) {
    const buttons = [...pro.querySelectorAll<HTMLButtonElement>('[data-role]')];
    const details = [...pro.querySelectorAll<HTMLElement>('[data-detail]')];
    const panel = pro.querySelector<HTMLElement>('[data-panel]');
    const wide = window.matchMedia('(min-width: 64rem)');
    const show = (i: number) => {
      buttons.forEach((b, k) => { b.classList.toggle('active', k === i); b.setAttribute('aria-expanded', String(k === i)); });
      details.forEach((d, k) => (d.hidden = k !== i));
      if (panel) {
        const copy = details[i].cloneNode(true) as HTMLElement;
        copy.removeAttribute('id');
        copy.hidden = false;
        panel.replaceChildren(copy);
      }
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => show(i));
      b.addEventListener('mouseenter', () => wide.matches && show(i));
      b.addEventListener('focus', () => wide.matches && show(i));
    });
    show(0);
  }

  // Additional experience and Business background pop-ups: X, Escape or a click outside closes them
  document.querySelectorAll<HTMLButtonElement>('[data-exp-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.expOpen!) as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-exp-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => btn.focus());
  });
</script>
