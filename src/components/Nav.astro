---
/**
 * Site header. On small screens the links fold into a "Menu" button.
 * Links point at sections on the home page, so they work from project pages too.
 */
import { site, resumeFile, showAbout, showExperience } from '../lib/data';

const links = [
  showAbout && { label: 'About', href: '/#about' },
  { label: 'What I do', href: '/#skills' },
  { label: 'Work', href: '/#work' },
  { label: 'Feedback', href: '/#feedback' },
  showExperience && { label: 'Experience', href: '/#experience' },
  { label: 'Contact', href: '/#contact' },
].filter((l): l is { label: string; href: string } => Boolean(l));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name} <span aria-hidden="true">|</span> <span class="tag">Portfolio</span></a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>

    <nav id="site-menu" class="menu" aria-label="Main">
      <ul>
        {links.map((l) => <li><a class:list={{ cta: l.label === 'Contact' }} href={l.href}>{l.label === 'Contact' ? 'Contact me' : l.label}</a></li>)}
        {resumeFile && <li><a class="resume" href={resumeFile} download>Resume (PDF)</a></li>}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .brand {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.01em;
   
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex; align-items: center; min-height: 2.75rem;
  }
  .brand [aria-hidden] { display: none; }
  .brand .tag {
    margin-left: 0.35rem;
    font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: var(--fs-small); letter-spacing: 0; text-transform: none;
    color: var(--wine);
  }
  @media (max-width: 22rem) { .brand .tag { display: none; } }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    color: var(--ink);
    font: 600 var(--fs-label) / 1 var(--font-sans);
    letter-spacing: 0.01em;
   
    cursor: pointer;
  }
  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 1.25rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .menu-icon { position: relative; transform: translateY(-3px); }
  .menu-icon::before { content: ''; position: absolute; top: 6px; }
  .menu-toggle[aria-expanded='true'] .menu-icon { transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-icon::before { transform: translateY(-6px) rotate(-90deg); }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .menu a:hover { color: var(--salsa); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.35em; }

  /* Mobile: drop-down panel */
  @media (max-width: 74.99rem) {
    .menu {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
      padding: 0.5rem var(--gutter) 1.5rem;
    }
    .menu[data-open='false'] { display: none; }
    .menu a {
      display: block;
      padding: 0.75rem 0;
      font-size: var(--fs-h3);
      font-weight: 700;
      letter-spacing: -0.04em;
     
      line-height: 1;
      border-bottom: 1px solid var(--line);
    }
  }

  /* Desktop: inline links */
  @media (min-width: 75rem) {
    .menu-toggle { display: none; }
    .menu ul { display: flex; gap: 1.75rem; }
    .menu a { white-space: nowrap; }
    .menu a {
      font-size: var(--fs-label);
      font-weight: 600;
      letter-spacing: 0.01em;
     
    }
    .menu ul { align-items: center; }
    .menu .resume { color: var(--wine); }
    .menu .cta {
      display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1.1rem;
      border-radius: var(--radius-pill); background: var(--wine); color: var(--paper);
    }
    .menu .cta:hover { background: var(--salsa); color: var(--paper); text-decoration: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-menu');
  const mq = window.matchMedia('(max-width: 74.99rem)');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.dataset.open = String(open);
  }

  if (toggle && menu) {
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    // Close after choosing a link, and on Escape (focus goes back to the button)
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a') && mq.matches) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
