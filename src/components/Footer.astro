---
import { site } from '../lib/data';
---

<footer class="site-footer">
  <div class="wrap foot">
    <p>&copy; {new Date().getFullYear()} {site.name}</p>
    <a href="#main">Back to top <span aria-hidden="true">&uarr;</span></a>
  </div>
</footer>

<style>
  /* A rounded panel in the same centered column as the sections */
  .site-footer {
    max-width: var(--max); margin: 0 max(var(--page-pad), (100% - var(--max)) / 2) var(--page-pad);
    border-radius: var(--panel-radius); background: var(--ink); color: var(--paper); --focus: var(--paper);
  }
  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 4.5rem;
    font-size: var(--fs-small);
  }
  .foot a { color: var(--paper); display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
