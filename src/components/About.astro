---
/**
 * About me: my photo with its background removed (src/assets/portrait-about-cutout.png, cut from the Cloudinary
 * "profile-about" photo), standing on the bottom edge of the section with no frame. Then bio, "Open to work", and the main actions
 * (Download CV once confirmed, Let's talk, See my work, My experience, Book a call).
 * Two cards open pop-ups:
 * - Certifications: one certificate at a time with previous/next, and a button over to Tools.
 * - Tools I use: rows of real tool logos drifting left and right, and a button back to Certifications.
 * Both pop-ups close with the X at the top, Escape, or a click outside.
 * Text: src/data/about.json. Certificates: "certifications" in src/data/proof.json. Tools: src/data/tools.json,
 * logos: src/data/tool-logos.json (files in public/tools).
 */
import { about, site, proof, tools, filled, resumeFile, bookingUrl, showUnconfirmed } from '../lib/data';
import { Picture } from 'astro:assets';
import { jpgUrl } from '../lib/cloudinary';
import Skills from './Skills.astro';
import cutout from '../assets/portrait-about-cutout.png';
import toolLogos from '../data/tool-logos.json';

const logos = toolLogos as Record<string, string>;


const everyTool = tools.groups.flatMap((g) => g.tools.map((t) => (typeof t === 'string' ? t : t.name))).filter((n) => logos[n]);
// Tools pop-up: the most role-relevant tools first, the full list on demand
const firstTools = ['Canva', 'CapCut', 'Adobe Photoshop', 'Adobe Lightroom Classic', 'Meta Business Suite', 'Instagram', 'TikTok', 'Later', 'Metricool', 'Insense', 'ChatGPT', 'Shopify'].filter((n) => everyTool.includes(n));
const allTools = [...firstTools, ...everyTool.filter((n) => !firstTools.includes(n))];
const TOP = firstTools.length;
// Tools pop-up: three drifting rows, the role-relevant tools first in the top row
const rest = allTools.slice(TOP);
const rows = [firstTools, rest.filter((_, i) => i % 2 === 0), rest.filter((_, i) => i % 2 === 1)];
const certs = proof.certifications;
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="wrap grid">
    <figure class="photo reveal" data-parallax>
      <Picture
        src={cutout}
        alt={about.portraitAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 40vw, 92vw"
        formats={['avif', 'webp']}
        loading="lazy"
      />
    </figure>

    <div class="copy reveal">
      <p class="kicker">About me</p>
      <h2 id="about-title">Hi, I'm <em>Hyacinth</em></h2>
      <div class="bio">
        {about.bio.map((p) => <p>{p}</p>)}
      </div>

      <div class="actions">
        {resumeFile ? (
          <a class="btn btn--secondary" href={resumeFile} target="_blank" rel="noopener">Download CV <span class="visually-hidden">(PDF, opens in a new tab)</span></a>
        ) : (
          showUnconfirmed && <span class="placeholder">Download CV appears once the CV is confirmed</span>
        )}
        <a class="btn btn--primary" href="#contact">Let's talk</a>
      </div>
      <div class="cards">
        <button type="button" class="pop-card lift" data-pop="certs" aria-haspopup="dialog">
          <span class="fan" aria-hidden="true">
            {certs.slice(0, 3).map((c, i) => <img src={jpgUrl(c.image, 240)} alt="" width="120" height="90" loading="lazy" style={`--i: ${i}`} />)}
          </span>
          <span class="pop-text"><strong>Certifications</strong><span>{certs.length} courses completed</span></span>
        </button>
        <button type="button" class="pop-card lift" data-pop="tools" aria-haspopup="dialog">
          <span class="fan tools-fan" aria-hidden="true">
            {allTools.slice(0, 5).map((n, i) => <img src={logos[n]} alt="" width="40" height="40" loading="lazy" style={`--i: ${i}`} />)}
          </span>
          <span class="pop-text"><strong>Tools I use</strong><span>{allTools.length} tools I work with</span></span>
        </button>
      </div>
    </div>
  </div>

  <div class="wrap"><Skills /></div>

  <dialog class="pop" id="pop-certs" aria-labelledby="pop-certs-title">
    <div class="pop-inner">
      <header class="pop-head">
        <h3 id="pop-certs-title">Certifications</h3>
        <button type="button" class="x" data-pop-close aria-label="Close">&times;</button>
      </header>
      <div class="cert-stage">
        {certs.map((c, i) => (
          <figure class="cert" data-cert={i} hidden={i !== 0}>
            <a href={jpgUrl(c.image, 1600)} target="_blank" rel="noopener">
              <img src={jpgUrl(c.image, 900)} width="900" height="670" alt={`${c.issuer} certificate for ${c.title}, issued to Hyacinth Blabagno`} loading="lazy" />
              <span class="visually-hidden">(opens the full certificate in a new tab)</span>
            </a>
            <figcaption><strong>{c.title}</strong><span>{c.issuer} &middot; {c.date}</span></figcaption>
          </figure>
        ))}
      </div>
      <footer class="pop-foot">
        <div class="pager">
          <button type="button" data-cert-prev aria-label="Previous certificate">&larr;</button>
          <span data-cert-pos aria-live="polite">1 / {certs.length}</span>
          <button type="button" data-cert-next aria-label="Next certificate">&rarr;</button>
        </div>
        <button type="button" class="btn btn--secondary" data-pop-switch="tools">View tools I use</button>
      </footer>
    </div>
  </dialog>

  <dialog class="pop pop-wide" id="pop-tools" aria-labelledby="pop-tools-title">
    <div class="pop-inner">
      <header class="pop-head">
        <h3 id="pop-tools-title">Tools I use</h3>
        <button type="button" class="x" data-pop-close aria-label="Close">&times;</button>
      </header>
      <div class="tool-body" data-tool-body>
        <div class="marquees" aria-hidden="true">
          {rows.map((row, r) => (
            <div class:list={['marquee', r % 2 ? 'right' : 'left']}>
              {[0, 1].map(() => (
                <ul role="list">
                  {row.map((n) => <li><img src={logos[n]} alt="" width="40" height="40" loading="lazy" /><span>{n}</span></li>)}
                </ul>
              ))}
            </div>
          ))}
        </div>
        <ul class="tool-grid" role="list" data-tool-grid>
          {allTools.map((n) => <li><img src={logos[n]} alt="" width="40" height="40" loading="lazy" /><span>{n}</span></li>)}
        </ul>
      </div>
      <footer class="pop-foot">
        <button type="button" class="btn btn--link" aria-pressed="false" data-tools-view>View as list</button>
        <button type="button" class="btn btn--secondary" data-pop-switch="certs">View certifications</button>
      </footer>
    </div>
  </dialog>
</section>

<style>
  .about { padding-block: var(--section) clamp(2.5rem, 2rem + 2vw, 4rem); }
  .grid { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 3.5rem); align-items: center; }
  @media (min-width: 64rem) { .grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }
  .grid > * { min-width: 0; }

  /* The portrait sits beside the copy, top-aligned with the heading, over a soft Sky block shifted down and left.
     On wide screens it drifts very slightly as you scroll (at most 20px). On phones it comes first, cropped to ~60% of the screen. */
  .photo { position: relative; margin: 0; width: 100%; max-width: 30rem; isolation: isolate; }
  .photo::before {
    content: ''; position: absolute; z-index: -1; inset: 12% 8% -4% -6%;
    border-radius: var(--radius-panel); background: rgb(165 183 229 / 0.35);
  }
  .photo :global(img) { transform: translateY(var(--px, 0px)); }
  .photo :global(picture), .photo :global(img) { display: block; width: 100%; height: auto; }
  @media (max-width: 63.99rem) {
    .photo { justify-self: center; }
    .photo :global(img) { max-height: 60vh; object-fit: cover; object-position: center top; }
  }
  .copy { display: grid; gap: 1.25rem; justify-items: start; }

  .status {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill); background: var(--status); color: var(--ink); font-weight: 700; font-size: var(--fs-small);
  }
  .status i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--ink); }
  .bio { display: grid; gap: 0.9rem; max-width: 58ch; }
  .bio p { color: var(--muted); }
  .bio p:first-child { font-size: var(--fs-lead); line-height: 1.5; color: var(--ink); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  /* Cards that open the pop-ups: thumbnails fan out on hover or focus */
  .cards { display: grid; gap: 0.75rem; width: 100%; max-width: 36rem; margin-top: 0.5rem; }
  @media (min-width: 30rem) { .cards { grid-template-columns: 1fr 1fr; } }
  .pop-card {
    display: flex; align-items: center; gap: 0.9rem; min-height: 4.75rem; padding: 0.75rem 0.9rem;
    border: 1px solid var(--rule); border-radius: var(--radius-panel); background: var(--paper);
    font: inherit; color: var(--ink); text-align: left; cursor: pointer;
  }
  .pop-card:hover, .pop-card:focus-visible { border-color: var(--ink); }
  .pop-card:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .fan { position: relative; flex: none; width: 4.75rem; height: 3rem; }
  .fan img {
    position: absolute; top: 0.2rem; left: 0; width: 3.25rem; height: 2.4rem; object-fit: cover;
    border-radius: 5px; border: 1px solid var(--rule); background: var(--paper);
    transform: translateX(calc(var(--i) * 0.55rem)) rotate(calc((var(--i) - 1) * 4deg));
    transition: transform 350ms var(--ease);
  }
  .pop-card:hover .fan img, .pop-card:focus-visible .fan img { transform: translateX(calc(var(--i) * 0.9rem)) rotate(calc((var(--i) - 1) * 9deg)); }
  .tools-fan img { width: 2rem; height: 2rem; top: 0.5rem; object-fit: contain; padding: 0.25rem; border-radius: 8px; transform: translateX(calc(var(--i) * 0.5rem)); }
  .pop-card:hover .tools-fan img, .pop-card:focus-visible .tools-fan img { transform: translateX(calc(var(--i) * 0.75rem)) translateY(calc((var(--i) % 2) * -5px)); }
  .pop-text { display: grid; gap: 0.1rem; }
  .pop-text strong { font-weight: 600; }
  .pop-text span { font-size: var(--fs-small); color: var(--muted); }

  /* Pop-ups */
  .pop {
    width: min(100vw - 2rem, 46rem); max-height: calc(100dvh - 2rem); padding: 0; border: 0;
    border-radius: var(--radius-panel); background: var(--paper); color: var(--ink); overflow: hidden;
  }
  .pop-wide { width: min(100vw - 2rem, 60rem); }
  .pop::backdrop { background: rgb(52 23 23 / 0.75); backdrop-filter: blur(3px); }
  .pop[open] { animation: pop-in 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes pop-in { from { opacity: 0; transform: translateY(10px) scale(0.98); } }
  .pop-inner { display: grid; grid-template-rows: auto 1fr auto; max-height: calc(100dvh - 2rem); }
  /* The middle scrolls; the header (with Close) and the footer stay in view */
  .pop-inner > :nth-child(2) { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .pop-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--rule); }
  .pop-head h3 { font-size: var(--fs-h3); }
  .x {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--rule); background: var(--paper);
    font-size: 1.5rem; line-height: 1; color: var(--ink); cursor: pointer;
  }
  .x:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .pop-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-top: 1px solid var(--rule); }

  .cert-stage { overflow: auto; padding: 1.25rem; }
  .cert { margin: 0; display: grid; gap: 0.75rem; }
  .cert[hidden] { display: none; }
  .cert:not([hidden]) { animation: fade 0.35s ease; }
  @keyframes fade { from { opacity: 0; transform: translateX(12px); } }
  .cert img { width: 100%; height: auto; max-height: calc(100vh - 16rem); object-fit: contain; border: 1px solid var(--rule); border-radius: var(--radius-media); background: var(--paper); }
  .cert figcaption { display: grid; gap: 0.1rem; }
  .cert figcaption span { font-size: var(--fs-small); color: var(--muted); }
  .pager { display: inline-flex; align-items: center; gap: 0.75rem; font-variant-numeric: tabular-nums; }
  .pager button {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--rule); background: var(--paper);
    font-size: 1.1rem; color: var(--ink); cursor: pointer;
  }
  .pager button:hover { border-color: var(--ink); }

  /* Tools: rows of logos drifting left and right */
  /* Tools: a grid, the most role-relevant first; "Show all" reveals the rest */
  .tool-grid { list-style: none; margin: 0; padding: 1.25rem; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); }
  .tool-grid li { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.75rem; border: 1px solid var(--rule); border-radius: var(--radius-media); font-size: var(--fs-small); font-weight: 600; }
  .tool-grid img { width: 1.75rem; height: 1.75rem; object-fit: contain; flex: none; }
  /* Tools: drifting rows by default; "View as list" shows the full grid instead */
  .tool-grid { display: none; }
  .tool-body.as-list .tool-grid { display: grid; }
  .tool-body.as-list .marquees { display: none; }
  .marquees { display: grid; gap: 0.9rem; padding: 1.5rem 0; overflow: hidden; }
  .marquee { display: flex; width: max-content; }
  .marquee ul { list-style: none; margin: 0; padding: 0 0.4rem; display: flex; gap: 0.6rem; flex: none; }
  .marquee li {
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.95rem 0.5rem 0.55rem;
    border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--paper); white-space: nowrap;
    font-size: var(--fs-small); font-weight: 600;
  }
  .marquee img { width: 1.75rem; height: 1.75rem; object-fit: contain; }
  @media (prefers-reduced-motion: no-preference) {
    .pop[open] .marquee.left { animation: tools-left 60s linear infinite; }
    .pop[open] .marquee.right { animation: tools-right 70s linear infinite; }
    .marquees:hover .marquee { animation-play-state: paused; }
    @keyframes tools-left { to { transform: translateX(-50%); } }
    @keyframes tools-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  }
  /* Reduced motion: the full list instead of moving rows */
  @media (prefers-reduced-motion: reduce) {
    .tool-body .marquees { display: none; }
    .tool-body .tool-grid { display: grid; }
    [data-tools-view] { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
  }
  @media (prefers-reduced-motion: reduce) {
  }
</style>

<script>
  const pops = { certs: document.getElementById('pop-certs'), tools: document.getElementById('pop-tools') } as Record<string, HTMLDialogElement | null>;
  let opener: HTMLElement | null = null;
  const open = (key: string) => pops[key]?.showModal();

  document.querySelectorAll<HTMLButtonElement>('[data-pop]').forEach((b) =>
    b.addEventListener('click', () => { opener = b; open(b.dataset.pop!); }),
  );
  Object.values(pops).forEach((d) => {
    if (!d) return;
    d.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === d || t.closest('[data-pop-close]')) d.close();
      const sw = t.closest<HTMLElement>('[data-pop-switch]');
      if (sw) { d.dataset.switching = '1'; d.close(); open(sw.dataset.popSwitch!); }
    });
    d.addEventListener('close', () => {
      if (!d.dataset.switching && !Object.values(pops).some((p) => p?.open)) opener?.focus();
      delete d.dataset.switching;
    });
  });

  // Tools: switch between the drifting rows and a plain list
  const view = document.querySelector<HTMLButtonElement>('[data-tools-view]');
  view?.addEventListener('click', () => {
    const body = document.querySelector('[data-tool-body]');
    const list = !body?.classList.contains('as-list');
    body?.classList.toggle('as-list', list);
    view.setAttribute('aria-pressed', String(list));
    view.textContent = list ? 'View as moving rows' : 'View as list';
  });

  // Portrait: a very small drift as you scroll (wide screens, motion allowed; at most 20px)
  const photo = document.querySelector<HTMLElement>('[data-parallax]');
  const wideScreen = window.matchMedia('(min-width: 64rem)');
  if (photo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!wideScreen.matches) { photo.style.removeProperty('--px'); return; }
      const r = photo.getBoundingClientRect();
      const p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight; // -1..1 around the middle of the screen
      photo.style.setProperty('--px', `${Math.max(-20, Math.min(20, p * -24)).toFixed(1)}px`);
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }

  // Certificates: one at a time
  const slides = [...document.querySelectorAll<HTMLElement>('[data-cert]')];
  const pos = document.querySelector<HTMLElement>('[data-cert-pos]');
  let current = 0;
  const go = (i: number) => {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, k) => (s.hidden = k !== current));
    if (pos) pos.textContent = `${current + 1} / ${slides.length}`;
  };
  document.querySelector('[data-cert-prev]')?.addEventListener('click', () => go(current - 1));
  document.querySelector('[data-cert-next]')?.addEventListener('click', () => go(current + 1));
  pops.certs?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(current + 1);
    if (e.key === 'ArrowLeft') go(current - 1);
  });
</script>
