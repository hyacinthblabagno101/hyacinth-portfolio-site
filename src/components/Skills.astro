---
/**
 * "What I do". Text comes from "skills" in src/data/about.json.
 * A skill with a category gets a link to matching work, but only when that category has projects.
 */
import { about } from '../lib/data';
import { showcase } from '../lib/data';

/** Where each skill's "see the work" link goes. Showcase links only appear when that tab has items. */
const has = (key: string) => showcase.some((c) => c.key === key);
const links: Record<string, { label: string; href: string } | undefined> = {
  'Short-Form Video': has('reels') ? { label: 'See video reels', href: '/?work=reels#work' } : undefined,
  'Social Media & Design': has('statics') ? { label: 'See statics', href: '/?work=statics#work' } : undefined,
  'UGC & Influencer': { label: 'See the case studies', href: '/#case-studies' },
};
---

<section id="skills" class="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">What I do</p>
      <h2 id="skills-title">Skills, and where to see them</h2>
    </header>

    <ol class="list" role="list">
      {
        about.skills.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.category && links[s.category] && (
              <a class="see" href={links[s.category]!.href}>
                {links[s.category]!.label} <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .skills { padding-block: 0 var(--section); }
  .head { display: grid; gap: 1rem; padding-top: var(--section); border-top: 1px solid var(--line); }
  .head .eyebrow { color: var(--rust); }

  .list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 2.5rem clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  @media (min-width: 40rem) { .list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .list { grid-template-columns: repeat(3, 1fr); } }

  li { display: grid; gap: 0.75rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--java); }
  .num { font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; color: var(--burgundy); line-height: 1; }
  li p { color: var(--text-muted); }
  .see { justify-self: start; font-weight: 600; font-size: var(--step-small); padding-block: 0.4rem; }
</style>
