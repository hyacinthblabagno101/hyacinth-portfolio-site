---
/**
 * "What I do". Text comes from "skills" in src/data/about.json.
 * A skill with a category gets a link to matching work, but only when that category has projects.
 */
import { about } from '../lib/data';
import { showcase } from '../lib/data';

/** Where each skill's "see the work" link goes. Showcase links only appear when that tab has items. */
const has = (key: string) => showcase.some((c) => c.key === key);
const links: Record<string, { label: string; href: string } | undefined> = {
  'Short-Form Video': has('reels') ? { label: 'See video reels', href: '/?work=reels#work' } : undefined,
  'Social Media & Design': has('statics') ? { label: 'See statics', href: '/?work=statics#work' } : undefined,
  'UGC & Influencer': { label: 'See the case studies', href: '/#case-studies' },
};
---

<section id="skills" class="skills band-dark" aria-labelledby="skills-title">
  <div class="wrap grid">
    <header class="side">
      <p class="eyebrow">Services</p>
      <h2 id="skills-title">What I <em>do</em></h2>
    </header>

    <ol class="list" role="list">
      {
        about.skills.map((s, i) => (
          <li class="reveal" style={`--delay: ${(i % 3) * 70}ms`}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
            {s.category && links[s.category] && (
              <a class="see" href={links[s.category]!.href}>
                {links[s.category]!.label} <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .skills { padding-block: var(--section); }
  .grid { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) { .grid { grid-template-columns: 0.8fr 1.4fr; gap: 4rem; align-items: start; } .side { position: sticky; top: 6rem; } }
  .side { display: grid; gap: 1rem; }
  .side .eyebrow { color: var(--chambray); }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li {
    display: grid; gap: 0.75rem 1.25rem; grid-template-columns: 2.5rem minmax(0, 1fr);
    padding: 1.5rem 0; border-bottom: 1px solid var(--line);
  }
  .num { font-family: var(--font-serif); font-style: italic; font-size: 1.25rem; color: var(--chambray); line-height: 1.2; }
  .body { display: grid; gap: 0.5rem; }
  h3 {
    font-family: var(--font-sans); font-weight: 700; letter-spacing: -0.03em;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.05;
  }
  .body p { color: var(--text-muted); max-width: 52ch; }
  .see {
    grid-column: 2; justify-self: start;
    display: inline-flex; gap: 0.5rem; align-items: center; min-height: 2.75rem;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cream);
  }
  .see:hover { color: var(--chambray); }
  @media (min-width: 48rem) {
    li { grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: start; }
    .see { grid-column: 3; }
  }
</style>
