---
/**
 * Capabilities, shown inside About (About.astro renders this). Text: "skills" in src/data/about.json.
 * - Three main capabilities in one row with fine dividers, each with at most one quiet link to matching work.
 * - The other three (e-commerce, AI workflows, virtual assistance) in a smaller supporting row.
 * - Phones: a list of buttons (title and one line); tapping one opens the full description (aria-expanded).
 *   Wide screens show everything open.
 * No "Talk about a role" buttons: the Contact section handles that.
 */
import { about, showcase } from '../lib/data';

const has = (key: string) => showcase.some((c) => c.key === key);
/** One quiet link per main capability, only where matching work exists */
const links: Record<string, { label: string; href: string } | undefined> = {
  'Social Media & Design': has('statics') ? { label: 'See statics', href: '/?work=statics#work' } : undefined,
  'Short-Form Video': has('reels') ? { label: 'See video reels', href: '/?work=reels#work' } : undefined,
  'UGC & Influencer': { label: 'See the case studies', href: '/#case-studies' },
};
const MAIN = ['Social media management', 'Creative production', 'UGC and influencer coordination'];

const all = about.skills.map((s, i) => ({
  ...s,
  id: `cap-${i + 1}`,
  // One line for the collapsed view: the text up to its first comma
  line: s.text.split(/,|\./)[0].trim(),
  link: s.category ? links[s.category] : undefined,
}));
const main = all.filter((s) => MAIN.includes(s.title));
const support = all.filter((s) => !MAIN.includes(s.title));
---

<div id="skills" class="caps reveal" aria-labelledby="caps-title">
  <h3 id="caps-title" class="caps-title">What I do</h3>

  <ul class="main" role="list">
    {main.map((s) => (
      <li class="cap">
        <button type="button" class="cap-toggle" aria-expanded="false" aria-controls={s.id} data-cap>
          <span class="cap-name">{s.title}</span>
          <span class="cap-line">{s.line}</span>
          <span class="chev" aria-hidden="true"></span>
        </button>
        <div class="cap-body" id={s.id} data-cap-body>
          <p>{s.text}</p>
          {s.link && <a class="btn btn--link" href={s.link.href}>{s.link.label}</a>}
        </div>
      </li>
    ))}
  </ul>

  <p class="label support-title">Also</p>
  <ul class="support" role="list">
    {support.map((s) => (
      <li class="cap small">
        <button type="button" class="cap-toggle" aria-expanded="false" aria-controls={s.id} data-cap>
          <span class="cap-name">{s.title}</span>
          <span class="cap-line">{s.line}</span>
          <span class="chev" aria-hidden="true"></span>
        </button>
        <div class="cap-body" id={s.id} data-cap-body>
          <p>{s.text}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .caps {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    border-radius: var(--radius-panel); background: var(--surface);
  }
  .caps-title { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); letter-spacing: -0.02em; margin-bottom: 1.25rem; }
  .main, .support { list-style: none; margin: 0; padding: 0; display: grid; }
  .cap { border-top: 1px solid var(--rule); }
  .cap-toggle {
    width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.15rem 1rem; align-items: center;
    min-height: 2.75rem; padding: 0.9rem 0; background: none; border: 0; text-align: left; cursor: pointer;
    font: inherit; color: var(--ink);
  }
  .cap-toggle:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  .cap-name { grid-column: 1; font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .small .cap-name { font-size: var(--fs-body); }
  .cap-line { grid-column: 1; font-size: var(--fs-small); color: var(--muted); }
  .chev { grid-column: 2; grid-row: 1 / span 2; width: 0.6rem; height: 0.6rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform 180ms ease; }
  .cap-toggle[aria-expanded='true'] .chev { transform: rotate(-135deg); }
  .cap-body { display: grid; gap: 0.5rem; padding: 0 0 1rem; justify-items: start; }
  .cap-body[hidden] { display: none; }
  .cap-body p { color: var(--muted); font-size: var(--fs-small); }
  .support-title { color: var(--muted); margin: 1.75rem 0 0.25rem; }

  /* Wide screens: everything open; main capabilities in three columns with fine dividers, supporting ones smaller */
  @media (min-width: 64rem) {
    .main { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .support { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cap { border-top: 0; border-left: 1px solid var(--rule); padding: 0 1.5rem; }
    .cap:first-child { border-left: 0; padding-left: 0; }
    .cap-toggle { cursor: default; padding-top: 0; }
    .cap-line, .chev { display: none; }
    .cap-body, .cap-body[hidden] { display: grid; }
    .cap-body p { font-size: var(--fs-body); }
    .small .cap-body p { font-size: var(--fs-small); }
    /* Main skills: large serif titles; a thin line draws under the title on hover, and the link slides in */
    .main .cap-name {
      font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 1.2rem + 0.8vw, 1.875rem); letter-spacing: -0.02em; line-height: 1.15;
      padding-bottom: 0.2rem;
      background: linear-gradient(var(--accent), var(--accent)) left bottom / 0 2px no-repeat;
      transition: background-size var(--t-move) var(--ease);
    }
    .main .cap:hover .cap-name, .main .cap:focus-within .cap-name { background-size: 100% 2px; }
  }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .main .cap-body .btn--link { opacity: 0.55; transform: translateX(-8px); transition: opacity var(--t-ui) var(--ease), transform var(--t-move) var(--ease); }
    .main .cap:hover .btn--link, .main .cap:focus-within .btn--link { opacity: 1; transform: none; }
  }
</style>

<script>
  // Phones: each capability opens with a tap (one line until then). Wide screens: all open.
  const caps = [...document.querySelectorAll<HTMLButtonElement>('[data-cap]')];
  const wide = window.matchMedia('(min-width: 64rem)');
  const setAll = () => caps.forEach((b) => {
    const body = document.getElementById(b.getAttribute('aria-controls')!);
    if (!body) return;
    body.hidden = !wide.matches && b.getAttribute('aria-expanded') !== 'true';
    if (wide.matches) b.setAttribute('aria-expanded', 'true');
  });
  caps.forEach((b) => b.addEventListener('click', () => {
    if (wide.matches) return;
    const open = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(open));
    const body = document.getElementById(b.getAttribute('aria-controls')!);
    if (body) body.hidden = !open;
  }));
  wide.addEventListener('change', () => {
    if (!wide.matches) caps.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    setAll();
  });
  setAll();
</script>
