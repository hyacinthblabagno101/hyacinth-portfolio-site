---
/**
 * Hero, centered: an "Open to work · Remote, Philippines" badge, the headline (rising word by word on load, with
 * hero.accent in site.json as the italic accent word), my role, a two-sentence intro, then See my work (filled) and Book a call (outlined).
 * Below it, one row of my reels as slightly tilted cards drifting sideways (9 reels, at most 2 per brand).
 * - The row pauses on hover or keyboard focus (no Pause button, by choice). With reduced motion it is still.
 * - A few reels play a short silent preview once the row is on screen.
 * - Reduced motion: the row stands still and you can swipe it. Without JavaScript the row still drifts (CSS only).
 * Text comes from "hero" in src/data/site.json; the reels are picked by id below.
 */
import { site, filled, showUnconfirmed, showcase, bookingUrl } from '../lib/data';
import { viewerEntry } from '../lib/showcaseMedia';
import { posterFor, videoPreviewUrl } from '../lib/cloudinary';

const { hero } = site;
const availability = filled(site.availability);
const shortRole = site.role.split('|')[0].trim();
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// Each word rises in turn on load (the page's one signature moment); hero.accent is the italic accent word
const accent = hero.accent?.toLowerCase();
const headlineHtml = escape(hero.headline)
  .split(' ')
  .map((w, i) => `<span class="word" style="--i: ${i}">${accent && w.toLowerCase().replace(/[^a-z'-]/g, '') === accent ? `<em>${w}</em>` : w}</span>`)
  .join(' ');

// The reel row: 9 reels, at most 2 per brand, opening with a mix of brands
const rowIds = [
  'reel-wc-founder-bags', 'reel-ss-top-trends', 'reel-rb-unboxing', 'reel-tj-food-dancing', 'reel-hs-bills',
  'reel-ss-olive-rack', 'reel-rb-patches', 'reel-tj-acoustic', 'reel-five-things',
];
const allReels = showcase.find((c) => c.key === 'reels')?.items ?? [];
const reels = rowIds
  .map((id) => allReels.find((r) => r.id === id))
  .filter((r): r is (typeof allReels)[number] => !!r)
  .map((r, i) => ({
    entry: viewerEntry(r),
    poster: posterFor({ id: r.media }, 360, '9:16'),
    // Every third reel plays a short silent preview
    preview: i % 3 === 1 ? videoPreviewUrl(r.media, 360, '9:16') : undefined,
    alt: r.alt,
    tilt: [-3, 2, -1.5, 3, -2.5, 1.5][i % 6],
  }));

const book = bookingUrl ? { href: bookingUrl, external: true } : { href: hero.secondaryCta.href, external: false };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap copy">
    <p class="badge rise">
      {availability ? <span class="status"><i aria-hidden="true" />{availability}</span> : showUnconfirmed && <span class="placeholder">{site.availability}</span>}
      <span class="where">Remote, {site.location}</span>
    </p>

    <h1 id="hero-title">
      <span class="visually-hidden">{site.name}, {shortRole}. </span>
      <span set:html={headlineHtml} />
    </h1>
    <p class="role rise" style="--delay: 0.3s">{shortRole}</p>
    <p class="intro rise" style="--delay: 0.36s">{hero.intro}</p>

    <div class="actions rise" style="--delay: 0.42s">
      <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn--secondary" href={book.href} target={book.external ? '_blank' : undefined} rel={book.external ? 'noopener' : undefined}>
        {hero.secondaryCta.label}
        {book.external && <span class="visually-hidden">(opens in a new tab)</span>}
      </a>
    </div>
  </div>

  <div class="reel-wrap rise" style="--delay: 0.5s">
    <div class="reel-row" role="group" aria-label="Recent reels" data-reel-row>
      <div class="belt">
        <ul class="track" role="list" data-viewer-list>
          {reels.map((r) => (
            <li style={`--tilt: ${r.tilt}deg`}>
              <a
                class="tile-link reel"
                href={r.entry.full}
                data-kind={r.entry.kind}
                data-full={r.entry.full}
                data-poster={r.entry.poster}
                data-title={r.entry.title}
                data-brand={r.entry.brand}
                data-alt={r.entry.alt}
                data-role={r.entry.role}
                data-aspect={r.entry.aspect}
              >
                <img src={r.poster} width="360" height="640" alt={r.alt} loading="eager" decoding="async" />
                {r.preview && <video muted loop playsinline preload="none" data-wall-src={r.preview} aria-hidden="true" />}
                {r.entry.brand && <span class="tag" aria-hidden="true">{r.entry.brand}</span>}
                <span class="visually-hidden">Play video: {r.entry.title}{r.entry.brand ? `, ${r.entry.brand}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
        {/* Two copies so the row loops without a gap; hidden from screen readers and the viewer */}
        {[0, 1].map(() => (
          <ul class="track copy-track" role="list" aria-hidden="true">
            {reels.map((r) => (
              <li style={`--tilt: ${r.tilt}deg`}>
                <span class="reel">
                  <img src={r.poster} width="360" height="640" alt="" loading="lazy" decoding="async" />
                  {r.entry.brand && <span class="tag">{r.entry.brand}</span>}
                </span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem); overflow: hidden; }
  .copy { display: grid; justify-items: center; text-align: center; gap: 1.1rem; }

  .badge {
    display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 0.6rem;
    padding: 0.3rem 0.85rem 0.3rem 0.3rem; border: 1px solid var(--rule); border-radius: var(--radius-pill);
    font-size: var(--fs-small); color: var(--muted); background: var(--paper);
  }
  .status {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill); background: var(--status); color: var(--ink); font-weight: 700;
  }
  .status i { position: relative; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .status i::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--ink); opacity: 0; animation: ping 2s ease-out infinite; }
    @keyframes ping { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.6); opacity: 0; } }
  }

  h1 { font-size: var(--fs-display); line-height: 1; letter-spacing: -0.035em; max-width: 10.8em; margin-inline: auto; } /* em, not ch: ch changes with the font, so the line breaks would change when the web font arrives */
  :global(.word) { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    h1 :global(.word) { animation: word-rise 700ms var(--ease) backwards; animation-delay: calc(120ms + var(--i) * 70ms); }
    @keyframes word-rise { from { opacity: 0; transform: translateY(0.35em); } }
  }
  .role { font-size: clamp(1.125rem, 1rem + 0.4vw, 1.25rem); font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .intro { color: var(--muted); max-width: 48ch; font-size: var(--fs-lead); line-height: 1.5; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 0.25rem; }
  @media (max-width: 30rem) { .actions { width: 100%; } .actions .btn { flex: 1 1 100%; } }

  /* The reel row: tilted cards on a belt that moves left by exactly one copy, then repeats */
  .reel-wrap { margin-top: clamp(2rem, 1.5rem + 2.5vw, 3.5rem); }
  .reel-row {
    overflow: hidden; padding-block: 1.25rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .belt { display: flex; width: max-content; }
  .track { list-style: none; margin: 0; padding: 0 0.5rem; display: flex; gap: 1rem; flex: none; }
  .track li { flex: none; width: clamp(8rem, 5rem + 9vw, 13rem); transform: rotate(var(--tilt)); transition: transform var(--t-move) var(--ease); }
  .track li:hover, .track li:focus-within { transform: rotate(0deg) translateY(-6px); }
  .reel {
    position: relative; display: block; overflow: hidden;
    aspect-ratio: 9 / 16; border-radius: 14px; background: var(--surface);
    box-shadow: 0 16px 30px -20px rgb(52 23 23 / 0.55);
    color: inherit; text-decoration: none;
  }
  .reel img, .reel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel video { opacity: 0; transition: opacity 0.6s ease; }
  .reel :global(video.playing) { opacity: 1; }
  .tag {
    position: absolute; left: 0.45rem; bottom: 0.45rem; z-index: 1;
    padding: 0.15rem 0.45rem; border-radius: var(--radius-pill);
    background: rgb(52 23 23 / 0.42); color: var(--paper); backdrop-filter: blur(4px);
    font-size: 12px; font-weight: 600;
    max-width: calc(100% - 1rem); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  a.reel:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  @media (prefers-reduced-motion: no-preference) {
    .belt { animation: belt 110s linear infinite; }
    .reel-row:hover .belt, .reel-row:focus-within .belt { animation-play-state: paused; }
    /* Three copies; move by exactly one */
    @keyframes belt { to { transform: translateX(calc(-100% / 3)); } }
  }
  /* Reduced motion: a still row you can swipe */
  @media (prefers-reduced-motion: reduce) {
    .reel-row { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-mask-image: none; mask-image: none; }
    .reel-row::-webkit-scrollbar { display: none; }
    .copy-track { display: none; }
    .track li { scroll-snap-align: start; }
  }
</style>

<script>
  // Start the few previews once the row is on screen; never with reduced motion or data saver
  const row = document.querySelector<HTMLElement>('[data-reel-row]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (row && !calm && !saveData) {
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      row.querySelectorAll<HTMLVideoElement>('video[data-wall-src]').forEach((v) => {
        v.src = v.dataset.wallSrc!;
        v.addEventListener('playing', () => v.classList.add('playing'), { once: true });
        v.play().catch(() => {});
      });
    }).observe(row);
  }
</script>
