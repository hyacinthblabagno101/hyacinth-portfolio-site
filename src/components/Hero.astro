---
/**
 * Hero, photo first (this site is my portfolio and resume in one): my name and role, "Open to work" in green,
 * the headline and intro, then See my work and Book a call (Calendly). My photo sits beside it.
 * Below it, the numbers bar counts up once when it scrolls into view (it shows the final numbers straight away
 * for reduced motion or without JavaScript).
 * Text and numbers come from "hero" and "stats" in src/data/site.json. Photo: src/assets/portrait-about.jpg.
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-about.jpg';
import { site, filled, showUnconfirmed, bookingUrl } from '../lib/data';

const { hero } = site;
const availability = filled(site.availability);
const role = site.role.split('|')[0].trim();
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const headlineHtml = escape(hero.headline).replace(/scrolling/i, (m) => `<em>${m}</em>`);
const book = bookingUrl ?? hero.secondaryCta.href;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="meta rise">
        <span class="who"><strong>{site.name}</strong> <span aria-hidden="true">/</span> {role}</span>
      </p>
      <p class="badges rise">
        {availability ? <span class="status"><i aria-hidden="true" />{availability}</span> : showUnconfirmed && <span class="placeholder">{site.availability}</span>}
        <span class="where">Remote, based in the {site.location}</span>
      </p>

      <h1 id="hero-title" class="rise" style="--delay: 0.06s">
        <span class="visually-hidden">{site.name}, {role}. </span>
        <span set:html={headlineHtml} />
      </h1>
      <p class="intro rise" style="--delay: 0.12s">{hero.intro}</p>

      <div class="actions rise" style="--delay: 0.18s">
        <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn-ghost" href={book} target="_blank" rel="noopener">
          {hero.secondaryCta.label} <span class="visually-hidden">(opens Calendly in a new tab)</span>
        </a>
      </div>
    </div>

    <figure class="photo rise" style="--delay: 0.1s">
      <Picture
        src={portrait}
        alt="Hyacinth Blabagno in a brown suit, on a phone call while working on a laptop"
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 40vw, 92vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<section class="stats" aria-label="At a glance">
  <ul class="wrap" role="list">
    {site.stats.map((s) => (
      <li>
        <strong><span data-count={s.value}>{s.value.toLocaleString('en-US')}</span>{s.suffix}</strong>
        <span>{s.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero { padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(2.5rem, 1.5rem + 3vw, 4rem); overflow-x: clip; }
  .grid { display: grid; gap: clamp(2rem, 1rem + 3vw, 4rem); align-items: center; }
  @media (min-width: 64rem) { .grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); } }
  .grid > * { min-width: 0; }

  .copy { display: grid; gap: 1.25rem; align-content: center; }
  .meta { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .meta strong { color: var(--ink); font-weight: 700; }
  .badges { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; font-size: var(--fs-small); color: var(--text-muted); }
  .status {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill); background: var(--green-soft); color: var(--green);
    font-weight: 700; font-size: var(--fs-small);
  }
  .status i { position: relative; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #2f9e4a; }
  @media (prefers-reduced-motion: no-preference) {
    .status i::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid #2f9e4a; opacity: 0; animation: ping 2s ease-out infinite; }
    @keyframes ping { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.6); opacity: 0; } }
  }

  h1 { font-size: clamp(2.75rem, 1.2rem + 5.4vw, 5.5rem); font-weight: 800; letter-spacing: -0.055em; line-height: 0.95; max-width: 11ch; }
  h1 :global(em) { font-size: 0.92em; }
  .intro { color: var(--text-muted); max-width: 46ch; font-size: var(--fs-lead); line-height: 1.5; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.25rem; }
  @media (max-width: 30rem) { .actions .btn { flex: 1 1 100%; } }

  .photo { margin: 0; justify-self: center; width: min(100%, 32rem); }
  .photo :global(img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 25%;
    border-radius: calc(var(--radius-media) * 2); background: #fff;
  }

  /* Numbers bar */
  .stats { background: var(--wine); color: var(--paper); }
  .stats ul {
    list-style: none; margin-block: 0; padding-block: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1rem; text-align: center;
  }
  @media (min-width: 48rem) { .stats ul { grid-template-columns: repeat(4, 1fr); } }
  .stats li { display: grid; gap: 0.35rem; }
  .stats strong { font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .stats li > span { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rose); }
</style>

<script>
  // Count the numbers up from zero whenever the bar comes into view (skipped with reduced motion).
  // It waits for the page to finish loading, so a bar that is already on screen doesn't finish counting unseen.
  const bar = document.querySelector<HTMLElement>('.stats');
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (bar && counters.length && !calm) {
    let frame = 0;
    const set = (p: number) => counters.forEach((el) => (el.textContent = Math.round(Number(el.dataset.count) * p).toLocaleString('en-US')));
    const run = () => {
      cancelAnimationFrame(frame);
      const start = performance.now() + 250;
      const step = (now: number) => {
        const t = Math.max(0, Math.min(1, (now - start) / 2200));
        set(1 - Math.pow(1 - t, 4));
        if (t < 1) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    };
    set(0);
    const watch = () => {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) run();
          else { cancelAnimationFrame(frame); set(0); }
        });
      }, { threshold: 0.6 }).observe(bar);
    };
    if (document.readyState === 'complete') watch();
    else window.addEventListener('load', watch, { once: true });
  }
</script>
