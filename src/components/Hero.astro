---
/**
 * Hero: introduction on the left, a compact profile card on the right, and a slow-moving strip
 * of recent work underneath so visitors see real work straight away.
 * Text comes from "hero" in src/data/site.json. Portrait: src/assets/portrait-hero.jpg.
 * The availability badge only shows once "availability" in site.json is filled in.
 * Strip items: featured items in src/data/showcase.json, plus the first ad, animation and two stories.
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-hero.jpg';
import { site, filled, publicEmail, publishedSocials, resumeFile, showUnconfirmed, showcase } from '../lib/data';
import { viewerEntry, tileMedia } from '../lib/showcaseMedia';

const { hero } = site;
const [first, ...rest] = site.name.split(' ');
// Keep hyphenated words like "hands-on" from splitting across two lines.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const headlineHtml = escape(hero.headline).replace(/(\S+-\S+)/g, '<span class="nowrap">$1</span>');

const availability = filled(site.availability);
const shortRole = site.role.split('|')[0].trim();
const linkedin = publishedSocials.find((s) => s.label === 'LinkedIn');

// Recent work strip
const tab = (key: string) => showcase.find((c) => c.key === key)?.items ?? [];
const featured = showcase.flatMap((c) => c.items.filter((i) => i.featured));
const extras = [...tab('ads').slice(0, 1), ...tab('animations').slice(0, 1), ...tab('stories').slice(0, 2)];
const strip = [...featured, ...extras.filter((i) => !featured.includes(i))].slice(0, 12).map((i) => ({
  entry: viewerEntry(i),
  media: tileMedia(i, '9:16', [240, 360]),
  alt: i.alt,
  kind: i.kind,
}));
---

<section class="hero band-dark" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow role rise">{site.role}</p>
      <h1 id="hero-title" class="name rise" style="--delay: 0.05s">
        {first} <em>{rest.join(' ')}</em>
      </h1>
      <p class="headline rise" style="--delay: 0.12s" set:html={headlineHtml} />
      <p class="intro rise" style="--delay: 0.18s">{hero.intro}</p>
      <div class="actions rise" style="--delay: 0.24s">
        <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>

    <aside class="card rise" style="--delay: 0.1s" aria-label="Profile">
      <div class="photo">
        <Picture
          src={portrait}
          alt={hero.portraitAlt}
          widths={[360, 560, 800]}
          sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 20rem, 86vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        {
          availability ? (
            <span class="status"><span class="dot" aria-hidden="true" />{availability}</span>
          ) : (
            showUnconfirmed && <span class="status placeholder">{site.availability}</span>
          )
        }
      </div>
      <div class="card-body">
        <p class="card-name">{site.name}</p>
        <p class="card-role">{shortRole}</p>
        <ul class="icons" role="list">
          {
            linkedin && (
              <li>
                <a href={linkedin.url} target="_blank" rel="me noopener" aria-label="LinkedIn (opens in a new tab)">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
                </a>
              </li>
            )
          }
          {
            publicEmail && (
              <li>
                <a href={`mailto:${publicEmail}?subject=${encodeURIComponent('Job opportunity')}`} aria-label={`Email ${publicEmail}`}>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 5h18v14H3zM3 6l9 7 9-7" /></svg>
                </a>
              </li>
            )
          }
        </ul>
      </div>
      <div class="card-actions">
        {resumeFile && <a class="btn btn-primary btn-sm" href={resumeFile} download>Download CV</a>}
        <a class="btn btn-outline-dark btn-sm" href="#contact">Contact me</a>
      </div>
    </aside>
  </div>

  {
    strip.length > 0 && (
      <div class="strip-wrap rise" style="--delay: 0.3s">
        <div class="wrap strip-head">
          <p class="eyebrow">A look at recent work</p>
          <a class="see-all" href="#work">See all work <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="strip" data-strip>
          <div class="track">
            {[0, 1].map((copy) => (
              <ul class="row" role="list" aria-hidden={copy === 1 ? 'true' : undefined} data-viewer-list={copy === 0 ? '' : undefined}>
                {strip.map((s) => (
                  <li>
                    <a
                      class="tile-link"
                      href={s.entry.full}
                      tabindex={copy === 1 ? -1 : undefined}
                      data-kind={s.entry.kind}
                      data-full={s.entry.full}
                      data-poster={s.entry.poster}
                      data-preview={s.media.preview}
                      data-title={s.entry.title}
                      data-brand={s.entry.brand}
                      data-alt={s.entry.alt}
                      data-role={s.entry.role}
                    >
                      <span class="frame">
                        <img
                          src={s.media.src}
                          srcset={s.media.srcset}
                          sizes="10rem"
                          width={s.media.width}
                          height={s.media.height}
                          alt={copy === 1 ? '' : s.alt}
                          loading="lazy"
                          decoding="async"
                        />
                        {s.kind === 'video' && (
                          <span class="play" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="12" height="12"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                          </span>
                        )}
                      </span>
                      <span class="visually-hidden">{s.kind === 'video' ? 'Play video' : 'View'}: {s.entry.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) clamp(2.5rem, 2rem + 3vw, 4rem);
    overflow: hidden;
  }
  .grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }
  .role { color: var(--chambray); max-width: 44ch; }
  .headline :global(.nowrap) { white-space: nowrap; }
  .name {
    margin-top: 1.25rem;
    font-size: var(--step-display);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .name em { display: block; font-style: italic; color: var(--bisque); }
  .headline {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    max-width: 24ch;
    font-family: var(--font-serif);
    font-size: var(--step-lede);
    line-height: 1.15;
    color: var(--cream);
    text-wrap: balance;
  }
  .intro { margin-top: 1.25rem; max-width: 52ch; color: var(--text-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* Profile card */
  .card {
    justify-self: center;
    width: min(100%, 22rem);
    padding: 0.75rem;
    border-radius: 28px;
    background: var(--cream);
    color: var(--java);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) { .card:hover { transform: translateY(-4px) rotate(-0.4deg); } }
  .photo { position: relative; }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 20px;
    background: var(--beige);
  }
  .status {
    position: absolute; top: 0.75rem; left: 0.75rem;
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgb(248 241 231 / 0.92);
    color: var(--java);
    font-size: 0.75rem; font-weight: 600;
  }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #2f9e44; box-shadow: 0 0 0 3px rgb(47 158 68 / 0.2); }
  .card-body { display: grid; gap: 0.2rem; padding: 1rem 0.5rem 0.4rem; }
  .card-name { margin: 0; font-family: var(--font-serif); font-size: 1.75rem; line-height: 1.05; }
  .card-role { margin: 0; font-size: var(--step-small); color: #4a2e27; }
  .icons { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; gap: 0.4rem; }
  .icons a {
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--beige); color: var(--burgundy);
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .icons a:hover { background: var(--burgundy); color: var(--cream); border-color: var(--burgundy); }
  .card-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; padding: 0 0.5rem 0.5rem; }
  .card-actions .btn { flex: 1 1 8rem; justify-content: center; white-space: nowrap; letter-spacing: 0.06em; }
  .card :global(.btn-sm) { min-height: 2.75rem; padding: 0.55rem 1rem; font-size: var(--step-small); }
  .btn-outline-dark { background: transparent; color: var(--java); border: 1px solid var(--java); }
  .btn-outline-dark:hover { background: var(--java); color: var(--cream); }
  .card .btn-primary { background: var(--burgundy); border-color: var(--burgundy); color: var(--cream); }
  .card .btn-primary:hover { background: var(--java); border-color: var(--java); }
  .card a:focus-visible { outline: 2px solid var(--burgundy); outline-offset: 2px; }

  @media (max-width: 30rem) { .actions .btn { flex: 1 1 100%; } }
  /* Phones: photo beside the details, so the card stays short and the work strip shows sooner */
  @media (max-width: 39.99rem) {
    .card {
      width: 100%;
      display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.25rem 0.9rem;
      border-radius: 22px; padding: 0.6rem;
    }
    .photo :global(img) { border-radius: 16px; }
    .status { position: static; margin-top: 0.5rem; font-size: 0.6875rem; padding: 0.3rem 0.6rem; }
    .card-body { padding: 0.35rem 0.25rem 0.25rem 0; align-content: start; }
    .card-name { font-size: 1.4rem; }
    .icons { margin-top: 0.4rem; }
    .icons a { width: 2.25rem; height: 2.25rem; }
    .card-actions { grid-column: 1 / -1; margin-top: 0.6rem; }
  }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: 1.5fr 1fr; }
    .card { justify-self: end; }
  }

  /* Recent work strip: drifts slowly sideways, pauses on hover or keyboard focus */
  .strip-wrap { margin-top: clamp(2.5rem, 2rem + 3vw, 4rem); }
  .strip-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .strip-head .eyebrow { color: var(--chambray); }
  .see-all { color: var(--bisque); font-weight: 600; font-size: var(--step-small); }
  .strip {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .track { display: flex; width: max-content; }
  .row { list-style: none; margin: 0; padding: 0.25rem 0.375rem; display: flex; gap: 0.75rem; }
  .row li { width: clamp(7.5rem, 6rem + 4vw, 10rem); }
  .tile-link { display: block; border-radius: 12px; }
  .tile-link:focus-visible { outline: 2px solid var(--chambray); outline-offset: 3px; }
  .frame {
    position: relative; display: block; overflow: hidden;
    aspect-ratio: 9 / 16; border-radius: 12px;
    background: rgb(248 241 231 / 0.08);
  }
  .frame img, .frame :global(video) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame :global(video) { opacity: 0; transition: opacity 0.35s ease; }
  .frame :global(video.playing) { opacity: 1; }
  .tile-link:hover .frame img { transform: scale(1.05); }
  .play {
    position: absolute; top: 0.5rem; right: 0.5rem; z-index: 2;
    display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: rgb(35 24 21 / 0.55); color: var(--cream);
  }

  @media (prefers-reduced-motion: no-preference) {
    .track { animation: drift 70s linear infinite; }
    .strip:hover .track, .strip:focus-within .track { animation-play-state: paused; }
    @keyframes drift { to { transform: translateX(-50%); } }
  }
  /* With reduced motion: no drifting, just a row you can scroll sideways */
  @media (prefers-reduced-motion: reduce) {
    .strip { overflow-x: auto; }
    .row[aria-hidden='true'] { display: none; }
  }
</style>
