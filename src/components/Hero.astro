---
/**
 * Hero: "Open to work", the headline, my role on its own line, a two-sentence intro, and two buttons
 * (See my work filled, Book a call outlined). Beside it, a wall of 9 reels from different brands (at most 2 each).
 * - Desktop: three columns drift slowly in opposite directions. Hover or focus pauses them, and a visible
 *   pause/play button stops them for good. One reel per column plays a short silent preview.
 * - Phones, tablets and reduced motion: one still row of posters you can swipe.
 * Text comes from "hero" in src/data/site.json; the reels are picked by id below.
 */
import { site, filled, showUnconfirmed, showcase, bookingUrl } from '../lib/data';
import { viewerEntry } from '../lib/showcaseMedia';
import { posterFor, videoPreviewUrl } from '../lib/cloudinary';

const { hero } = site;
const availability = filled(site.availability);
const shortRole = site.role.split('|')[0].trim();
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// "scrolling" is set in the italic accent
const headlineHtml = escape(hero.headline).replace(/scrolling/i, (m) => `<em>${m}</em>`);

// Reel wall: 9 reels, at most 2 per brand, opening with a mix of brands. One column per row of 3 ids.
const wallIds = [
  ['reel-wc-founder-bags', 'reel-tj-food-dancing', 'reel-rb-patches'],
  ['reel-ss-top-trends', 'reel-hs-bills', 'reel-tj-acoustic'],
  ['reel-rb-unboxing', 'reel-ss-olive-rack', 'reel-five-things'],
];
const allReels = showcase.find((c) => c.key === 'reels')?.items ?? [];
const columns = wallIds.map((ids) =>
  ids
    .map((id) => allReels.find((r) => r.id === id))
    .filter((r): r is (typeof allReels)[number] => !!r)
    .map((r, i) => ({
      entry: viewerEntry(r),
      poster: posterFor({ id: r.media }, 360, '9:16'),
      // The second reel in each column plays a short silent preview
      preview: i === 1 ? videoPreviewUrl(r.media, 360, '9:16') : undefined,
      alt: r.alt,
    })),
);

const book = bookingUrl ? { href: bookingUrl, external: true } : { href: hero.secondaryCta.href, external: false };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="meta rise">
        {availability ? <span class="status"><i aria-hidden="true" />{availability}</span> : showUnconfirmed && <span class="placeholder">{site.availability}</span>}
        <span>{site.name}, remote, based in the {site.location}</span>
      </p>

      <h1 id="hero-title" class="rise" style="--delay: 0.06s">
        <span class="visually-hidden">{site.name}, {shortRole}. </span>
        <span set:html={headlineHtml} />
      </h1>
      <p class="role rise" style="--delay: 0.09s">{shortRole}</p>

      <p class="intro rise" style="--delay: 0.12s">{hero.intro}</p>

      <div class="actions rise" style="--delay: 0.18s">
        <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn--secondary" href={book.href} target={book.external ? '_blank' : undefined} rel={book.external ? 'noopener' : undefined}>
          {hero.secondaryCta.label}
          {book.external && <span class="visually-hidden">(opens in a new tab)</span>}
        </a>
      </div>

    </div>

    <div class="wall-wrap rise" style="--delay: 0.15s">
    <button type="button" class="wall-toggle" aria-pressed="false" data-wall-toggle>
      <span class="when-playing"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg> Pause</span>
      <span class="when-paused"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg> Play</span>
      <span class="visually-hidden"> the moving reels</span>
    </button>
    <div class="wall" role="group" aria-label="Recent reels">
      {
        columns.map((col, c) => (
          <div class:list={['col', `col-${c + 1}`]}>
            <ul class="track" role="list" data-viewer-list>
              {col.map((r) => (
                <li>
                  <a
                    class="tile-link reel"
                    href={r.entry.full}
                    data-kind={r.entry.kind}
                    data-full={r.entry.full}
                    data-poster={r.entry.poster}
                    data-title={r.entry.title}
                    data-brand={r.entry.brand}
                    data-alt={r.entry.alt}
                    data-role={r.entry.role}
                    data-aspect={r.entry.aspect}
                  >
                    <img src={r.poster} width="360" height="640" alt={r.alt} loading={c === 1 ? 'eager' : 'lazy'} decoding="async" />
                    {r.preview && <video muted loop playsinline preload="none" data-wall-src={r.preview} aria-hidden="true" />}
                    {r.entry.brand && <span class="tag" aria-hidden="true">{r.entry.brand}</span>}
                    <span class="visually-hidden">Play video: {r.entry.title}{r.entry.brand ? `, ${r.entry.brand}` : ''}</span>
                  </a>
                </li>
              ))}
            </ul>
            {/* A copy of the column so the drift loops without a gap; hidden from screen readers and the viewer */}
            <ul class="track copy-track" role="list" aria-hidden="true">
              {col.map((r) => (
                <li>
                  <span class="reel">
                    <img src={r.poster} width="360" height="640" alt="" loading="lazy" decoding="async" />
                    {r.entry.brand && <span class="tag">{r.entry.brand}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    </div>
  </div>
</section>


<style>
  .hero { padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5rem); overflow-x: clip; }
  .grid { display: grid; gap: clamp(2rem, 1rem + 3vw, 3.5rem); align-items: center; }
  @media (min-width: 64rem) { .grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; } }
  .grid > * { min-width: 0; }

  .copy { display: grid; gap: clamp(1.25rem, 1rem + 1vw, 1.75rem); align-content: center; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; font-size: var(--fs-small); color: var(--muted); }
  /* My role, on its own line under the headline */
  .role { font-size: clamp(1.125rem, 1rem + 0.4vw, 1.25rem); font-weight: 600; letter-spacing: -0.01em; color: var(--ink); margin-top: -0.25rem; }
  .status {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill); background: var(--status); color: var(--ink);
    font-weight: 700; font-size: var(--fs-small);
  }
  .status i { position: relative; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .status i::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--ink); opacity: 0; animation: ping 2s ease-out infinite; }
    @keyframes ping { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.6); opacity: 0; } }
  }


  h1 {
    font-size: var(--fs-display);
    line-height: 1; letter-spacing: -0.035em;
    max-width: 12ch;
  }
  .intro { color: var(--muted); max-width: 46ch; font-size: var(--fs-lead); line-height: 1.5; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  @media (max-width: 30rem) { .actions .btn { flex: 1 1 100%; } }


  /* Reel wall */
  .wall {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem;
    height: clamp(30rem, 24rem + 14vw, 40rem);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
  }
  .col { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .col-2 { margin-top: -4rem; }
  .track { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .reel {
    position: relative; display: block; overflow: hidden;
    aspect-ratio: 9 / 16; border-radius: var(--radius-media); background: var(--surface);
    color: inherit; text-decoration: none;
  }
  .reel img, .reel video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .reel img { transition: transform 0.5s ease; }
  a.reel:hover img { transform: scale(1.03); }
  .reel video { opacity: 0; transition: opacity 0.6s ease; }
  .reel :global(video.playing) { opacity: 1; }
  .tag {
    position: absolute; left: 0.45rem; bottom: 0.45rem; z-index: 1;
    padding: 0.15rem 0.45rem; border-radius: var(--radius-pill);
    background: rgb(52 23 23 / 0.42); color: var(--paper); backdrop-filter: blur(4px);
    font-size: 12px; font-weight: 600;
    max-width: calc(100% - 1rem); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  a.reel:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }

  .wall-wrap { position: relative; }
  /* Pause/play: only shown where the wall actually moves (wide screens, motion allowed) */
  .wall-toggle {
    position: absolute; right: 0.5rem; bottom: 0.75rem; z-index: 3;
    display: none; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0 0.9rem;
    border: 1px solid var(--rule); border-radius: var(--radius-pill); background: var(--paper); color: var(--ink);
    font: inherit; font-size: var(--fs-small); font-weight: 600; cursor: pointer;
    transition: background-color 0.18s ease;
  }
  .wall-toggle:hover { background: var(--surface); }
  .wall-toggle span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .wall-toggle .when-paused, .wall-toggle[aria-pressed='true'] .when-playing { display: none; }
  .wall-toggle[aria-pressed='true'] .when-paused { display: inline-flex; }

  /* The drift: each column moves by exactly one copy of itself, then repeats, at half the old speed.
     Hover or focus pauses it; the button pauses it until pressed again. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .wall-toggle { display: inline-flex; }
    .col { animation: drift-up 96s linear infinite; }
    .col-2 { animation-name: drift-down; animation-duration: 112s; }
    .col-3 { animation-duration: 104s; }
    .wall:hover .col, .wall:focus-within .col, .wall[data-paused] .col { animation-play-state: paused; }
    @keyframes drift-up { to { transform: translateY(calc(-50% - 0.375rem)); } }
    @keyframes drift-down { from { transform: translateY(calc(-50% - 0.375rem)); } to { transform: translateY(0); } }
  }

  /* Phones, tablets and reduced motion: one still row of posters you can swipe */
  @media (max-width: 63.99rem), (prefers-reduced-motion: reduce) {
    .wall {
      display: flex; gap: 0.6rem; height: auto;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      -webkit-mask-image: none; mask-image: none;
    }
    .wall::-webkit-scrollbar { display: none; }
    .col, .track { display: contents; }
    .col-2 { margin: 0; }
    .copy-track { display: none; }
    .track li { flex: none; width: clamp(7rem, 5rem + 10vw, 10rem); scroll-snap-align: start; }
  }
</style>
<script>
  // Start the few wall previews once the wall is on screen; never with reduced motion or data saver
  const wall = document.querySelector<HTMLElement>('.hero .wall');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (wall && !calm && !saveData) {
    const start = () => {
      wall.querySelectorAll<HTMLVideoElement>('video[data-wall-src]').forEach((v) => {
        v.src = v.dataset.wallSrc!;
        v.addEventListener('playing', () => v.classList.add('playing'), { once: true });
        v.play().catch(() => {});
      });
    };
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        start();
        obs.disconnect();
      }
    }).observe(wall);
  }

  // Pause/play for the moving wall (the button only shows where the wall moves)
  const toggle = document.querySelector<HTMLButtonElement>('[data-wall-toggle]');
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(paused));
    wall?.toggleAttribute('data-paused', paused);
  });
</script>
