---
/**
 * Hero, set like a social media portfolio cover:
 * 1. A thin meta line: my role on the left, where I'm based (and availability, once it's set) on the right.
 * 2. Big type: "SOCIAL media MANAGER".
 * 3. Below: my intro and buttons, a stack of polaroids (my photo plus two pieces of work that open in the viewer),
 *    and a column of facts counted straight from the site's own data, so they are always true.
 * Text comes from "hero" in src/data/site.json. Photo: src/assets/portrait-about.jpg.
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-about.jpg';
import { site, about, filled, publicEmail, publishedSocials, resumeFile, showUnconfirmed, showcase, proof } from '../lib/data';
import { viewerEntry, tileMedia } from '../lib/showcaseMedia';

const { hero } = site;
const availability = filled(site.availability);
const shortRole = site.role.split('|')[0].trim();
const location = site.location;
const linkedin = publishedSocials.find((s) => s.label === 'LinkedIn');
const mailto = publicEmail ? `mailto:${publicEmail}?subject=${encodeURIComponent('Job opportunity')}` : undefined;

const items = showcase.flatMap((c) => c.items);
const brands = new Set(items.map((i) => i.brand).filter(Boolean));

// Facts: every number is counted from the data files, never typed in by hand
const facts = [
  { value: brands.size, label: 'brands featured', href: '#selected' },
  { value: proof.caseStudies.length, label: 'case studies', href: '#case-studies' },
  { value: proof.certifications.length, label: 'certificates', href: '#certifications' },
];

// Two polaroids of real work beside my photo
const pick = (id: string) => items.find((i) => i.id === id);
const polaroids = [pick('board-properecom'), pick('reel-ss-top-trends') ?? items[0]]
  .filter((i): i is NonNullable<typeof i> => !!i)
  .map((i) => ({ entry: viewerEntry(i), media: tileMedia(i, i.kind === 'video' ? '9:16' : '4:5', [320, 480]), kind: i.kind, alt: i.alt }));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="meta rise">
      <span>{shortRole}</span>
      <span class="right">
        <span class="loc">Based in the {location}</span>
        {availability ? <span class="status"><i aria-hidden="true" />{availability}</span> : showUnconfirmed && <span class="placeholder">{site.availability}</span>}
      </span>
    </p>

    <div class="title rise" style="--delay: 0.05s">
      <h1 id="hero-title" class="mast">
        <span class="visually-hidden">{site.name}, </span>
        <span class="l1">Social <em>media</em></span>
        <span class="l2">Manager</span>
      </h1>
    </div>

    <div class="below">
      <div class="copy rise" style="--delay: 0.12s">
        <p class="hi">Hi, I'm <em>Hyacinth.</em></p>
        <p class="intro">{hero.intro.replace(/^I'm Hyacinth, a/, 'A')}</p>
        <div class="actions">
          <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
          <a class="btn btn-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
        </div>
        <p class="links">
          {linkedin && <a href={linkedin.url} target="_blank" rel="me noopener">LinkedIn <span class="visually-hidden">(opens in a new tab)</span><span aria-hidden="true">&#8599;</span></a>}
          {mailto && <a href={mailto}>Email</a>}
          {resumeFile && <a href={resumeFile} download>Download CV</a>}
        </p>
      </div>

      <div class="polaroids rise" style="--delay: 0.2s">
        <figure class="card me">
          <Picture
            src={portrait}
            alt={about.portraitAlt}
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 15rem, 46vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>that's me</figcaption>
        </figure>
        <ul role="list" aria-label="Recent work" data-viewer-list>
          {polaroids.map((p, n) => (
            <li class:list={['card', `work-${n + 1}`]}>
              <a
                class="tile-link"
                href={p.entry.full}
                data-kind={p.entry.kind}
                data-full={p.entry.full}
                data-poster={p.entry.poster}
                data-title={p.entry.title}
                data-brand={p.entry.brand}
                data-alt={p.entry.alt}
                data-role={p.entry.role}
              >
                <span class="frame">
                  <img src={p.media.src} srcset={p.media.srcset} sizes="(min-width: 64rem) 12rem, 36vw" width={p.media.width} height={p.media.height} alt={p.alt} loading="eager" decoding="async" />
                  {p.kind === 'video' && (
                    <span class="play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="11" height="11"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                    </span>
                  )}
                </span>
                <span class="cap" aria-hidden="true">{p.entry.brand ?? p.entry.title}</span>
                <span class="visually-hidden">{p.kind === 'video' ? 'Play video' : 'View'}: {p.entry.title}{p.entry.brand ? `, ${p.entry.brand}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <ul class="facts rise" style="--delay: 0.26s" role="list" aria-label="This portfolio at a glance">
        {facts.map((f) => (
          <li>
            <a href={f.href}><strong>{f.value}</strong><span>{f.label}</span></a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.25rem, 1rem + 1.5vw, 2rem) clamp(3.5rem, 2.5rem + 4vw, 6rem); overflow-x: clip; }

  .meta {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem;
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted);
  }
  .meta .right { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .meta .right { align-items: center; }
  .status { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.2rem 0.65rem; border: 1px solid var(--line); border-radius: 999px; color: var(--java); }
  .status i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #2b8a3e; box-shadow: 0 0 0 3px var(--pink-soft); }

  /* Big type */
  .title { position: relative; margin-top: clamp(1.25rem, 0.8rem + 2vw, 2.5rem); }
  .mast {
    font-family: var(--display-font);
    font-size: var(--step-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-transform);
    letter-spacing: var(--display-tracking);
    line-height: 0.86;
  }
  .mast > span:not(.visually-hidden) { display: block; }
  .mast em { font-size: 1.04em; letter-spacing: -0.02em; }
  .mast .l2 { text-align: right; }

  /* Below: intro, polaroids, facts */
  .below {
    display: grid; gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-top: clamp(2.25rem, 1.5rem + 3vw, 4rem);
  }
  @media (min-width: 64rem) {
    .below { grid-template-columns: 1fr 1.15fr 0.8fr; align-items: end; gap: 3rem; margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  }
  .below > * { min-width: 0; }

  .hi { font-family: var(--font-serif); font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem); line-height: 1.05; color: var(--java); }
  .hi em { color: var(--rust); }
  .intro { margin-top: 0.9rem; color: var(--text-muted); max-width: 44ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
  @media (max-width: 30rem) { .actions .btn { flex: 1 1 100%; } }
  .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-top: 1.1rem; }
  .links a {
    display: inline-flex; align-items: center; gap: 0.25rem; min-height: 2.75rem;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--java);
  }
  .links a:hover { color: var(--rust); }

  /* Polaroids */
  .polaroids { position: relative; height: clamp(21rem, 15rem + 18vw, 27rem); }
  .polaroids ul { list-style: none; margin: 0; padding: 0; }
  .card {
    position: absolute; margin: 0;
    width: clamp(8.5rem, 5rem + 10vw, 12rem);
    padding: 0.55rem 0.55rem 0;
    background: #fff;
    box-shadow: 0 1px 2px rgb(29 21 19 / 0.08), 0 14px 30px -12px rgb(29 21 19 / 0.35);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card :global(img), .frame img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--beige); }
  .me :global(img) { object-position: 50% 20%; }
  .card figcaption, .cap {
    display: block; padding: 0.45rem 0 0.55rem; text-align: center;
    font-family: var(--font-serif); font-style: italic; font-size: 1.05rem; line-height: 1.2; color: var(--java);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .me { left: 0; top: 8%; transform: rotate(-5deg); z-index: 2; }
  .work-1 { left: 27%; top: 0; transform: rotate(4deg); z-index: 1; }
  .work-2 { right: 0; top: 22%; transform: rotate(-2deg); z-index: 3; }
  .tile-link { display: block; color: inherit; text-decoration: none; }
  .tile-link:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .frame { position: relative; display: block; overflow: hidden; }
  .play {
    position: absolute; top: 0.5rem; left: 0.5rem;
    display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: var(--cream); color: var(--java);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover { transform: rotate(0deg) translateY(-6px); z-index: 4; }
  }

  /* Facts: number left, italic label right, hairlines between */
  .facts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--java); }
  .facts a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding: 0.8rem 0; border-bottom: 1px solid var(--line);
    color: var(--java); text-decoration: none;
    transition: padding 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .facts a:hover { padding-left: 0.4rem; }
  .facts strong { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .facts span { font-family: var(--font-serif); font-style: italic; font-size: 1.05rem; color: var(--text-muted); }
  .facts a:hover span { color: var(--rust); }

  /* Phones and tablets: intro, then polaroids, then facts */
  @media (max-width: 63.99rem) {
    .polaroids { max-width: 30rem; width: 100%; justify-self: center; height: clamp(17rem, 12rem + 20vw, 22rem); }
    .card { width: clamp(8rem, 5rem + 12vw, 10.5rem); }
    .me { left: 0; top: 4%; }
    .work-1 { left: 33%; top: 12%; transform: rotate(3deg); }
    .work-2 { right: 0; top: 0; transform: rotate(-3deg); }
  }
  @media (max-width: 40rem) { .below { margin-top: 2.25rem; } }
</style>
