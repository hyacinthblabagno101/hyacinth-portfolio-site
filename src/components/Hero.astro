---
/**
 * Hero, laid out like a magazine opener:
 * 1. Masthead: my name, very large.
 * 2. Info bar: role, location, and availability (availability only once it's set in site.json).
 * 3. Spread: photo with a compact profile caption (name, role, LinkedIn, email, Download CV),
 *    the headline, intro and an index of the page, then a stack of real work that opens in the viewer.
 * Text comes from "hero" in src/data/site.json. Photo: src/assets/portrait-about.jpg.
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-about.jpg';
import { site, about, filled, publicEmail, publishedSocials, resumeFile, showUnconfirmed, showcase, proof } from '../lib/data';
import { viewerEntry, tileMedia } from '../lib/showcaseMedia';

const { hero } = site;
const [first, ...rest] = site.name.split(' ');
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// "hands-on work" is set in rust italics; hyphenated words never split across lines
const headlineHtml = escape(hero.headline)
  .replace(/hands-on work/i, (m) => `<em>${m}</em>`)
  .replace(/(\S+-\S+)/g, '<span class="nowrap">$1</span>');

const availability = filled(site.availability);
const shortRole = site.role.split('|')[0].trim();
const location = site.location.replace(', Philippines', ', PH');
const linkedin = publishedSocials.find((s) => s.label === 'LinkedIn');
const mailto = publicEmail ? `mailto:${publicEmail}?subject=${encodeURIComponent('Job opportunity')}` : undefined;

const total = showcase.reduce((n, c) => n + c.items.length, 0);
const index = [
  { label: 'Selected work', href: '#work', count: `${total} pieces` },
  { label: 'Case studies', href: '#case-studies', count: String(proof.caseStudies.length).padStart(2, '0') },
  { label: 'Client feedback', href: '#feedback', count: String(proof.testimonials.length).padStart(2, '0') },
  { label: 'Certifications', href: '#certifications', count: String(proof.certifications.length).padStart(2, '0') },
];

// Stack of real work beside the intro: one reel and two design boards
const items = showcase.flatMap((c) => c.items);
const pick = (id: string) => items.find((i) => i.id === id);
const stack = [pick('reel-ss-top-trends') ?? items[0], pick('board-properecom'), pick('board-rabble')]
  .filter((i): i is NonNullable<typeof i> => !!i)
  .map((i, n) => ({ entry: viewerEntry(i), media: tileMedia(i, n === 0 ? '9:16' : '4:5', [320, 480]), kind: i.kind, alt: i.alt }));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="mast rise">
      <span>{first}</span>
      <span class="indent">{rest.join(' ')}</span>
    </h1>

    <p class="info rise" style="--delay: 0.06s">
      <span>{shortRole}</span>
      <span class="loc">{location}</span>
      {availability ? <span class="status"><i aria-hidden="true" />{availability}</span> : showUnconfirmed && <span class="placeholder">{site.availability}</span>}
    </p>

    <div class="spread">
      <figure class="photo rise" style="--delay: 0.1s">
        <Picture
          src={portrait}
          alt={about.portraitAlt}
          widths={[400, 640, 900]}
          sizes="(min-width: 64rem) 28vw, (min-width: 40rem) 60vw, 92vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="profile">
          <span class="who">
            <strong>{site.name}</strong>
            <span>{shortRole}</span>
          </span>
          <span class="links">
            {linkedin && (
              <a href={linkedin.url} target="_blank" rel="me noopener" aria-label="LinkedIn (opens in a new tab)">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" /></svg>
              </a>
            )}
            {mailto && (
              <a href={mailto} aria-label={`Email ${publicEmail}`}>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 5h18v14H3zM3 6l9 7 9-7" /></svg>
              </a>
            )}
            {resumeFile && <a class="cv" href={resumeFile} download>Download CV</a>}
          </span>
        </figcaption>
      </figure>

      <div class="copy rise" style="--delay: 0.16s">
        <p class="headline" set:html={headlineHtml} />
        <p class="intro">{hero.intro}</p>
        <ul class="index" role="list" aria-label="On this page">
          {index.map((i) => (
            <li><a href={i.href}><span>{i.label}</span><span class="n">{i.count}</span></a></li>
          ))}
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
          <a class="btn btn-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
        </div>
      </div>

      <ul class="stack rise" style="--delay: 0.22s" role="list" aria-label="Recent work" data-viewer-list>
        {stack.map((s) => (
          <li>
            <a
              class="tile-link"
              href={s.entry.full}
              data-kind={s.entry.kind}
              data-full={s.entry.full}
              data-poster={s.entry.poster}
              data-preview={s.media.preview}
              data-title={s.entry.title}
              data-brand={s.entry.brand}
              data-alt={s.entry.alt}
              data-role={s.entry.role}
            >
              <span class="frame">
                <img src={s.media.src} srcset={s.media.srcset} sizes="(min-width: 64rem) 14vw, 30vw" width={s.media.width} height={s.media.height} alt={s.alt} loading="eager" decoding="async" />
                {s.kind === 'video' && (
                  <span class="play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="11" height="11"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                  </span>
                )}
              </span>
              <span class="visually-hidden">{s.kind === 'video' ? 'Play video' : 'View'}: {s.entry.title}{s.entry.brand ? `, ${s.entry.brand}` : ''}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.25rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5rem); }

  /* 1. Masthead */
  .mast {
    font-size: var(--step-display);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 0.84;
    letter-spacing: -0.055em;
  }
  .mast span { display: block; }
  .mast .indent { padding-left: 12%; }

  /* 2. Info bar */
  .info {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem;
    margin-top: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    padding: 0.7rem 0;
    border-top: 1px solid var(--java); border-bottom: 1px solid var(--line);
    font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted);
  }
  .status { display: inline-flex; align-items: center; gap: 0.5rem; }
  .status i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #2b8a3e; }

  /* 3. Spread */
  .spread {
    display: grid; gap: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
  }
  @media (min-width: 64rem) { .spread { grid-template-columns: 1fr 1fr 1.05fr; align-items: start; } }
  .spread > * { min-width: 0; }
  .stack li { min-width: 0; }

  .photo { margin: 0; }
  .photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; background: var(--beige); }
  .profile {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;
    margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
  }
  .who { display: grid; font-size: var(--step-small); line-height: 1.35; }
  .who span { color: var(--text-muted); }
  .links { display: flex; align-items: center; gap: 0.4rem; }
  .links a {
    display: grid; place-items: center;
    min-width: 2.5rem; height: 2.5rem; padding: 0 0.6rem;
    border: 1px solid var(--line); color: var(--java);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .links a:hover { background: var(--java); color: var(--cream); }
  .links .cv { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }

  .headline {
    font-family: var(--font-serif);
    font-size: var(--step-lede);
    line-height: 1.04;
    color: var(--java);
    text-wrap: balance;
  }
  .headline :global(em) { color: var(--rust); }
  .headline :global(.nowrap) { white-space: nowrap; }
  .intro { margin-top: 1.25rem; color: var(--text-muted); max-width: 46ch; }

  .index { list-style: none; margin: 1.75rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .index a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    min-height: 2.75rem; padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--java); font-weight: 500; text-decoration: none;
    transition: padding 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.2s ease;
  }
  .index a:hover { padding-left: 0.5rem; color: var(--rust); }
  .n { color: var(--rust); font-weight: 500; }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  @media (max-width: 30rem) { .actions .btn { flex: 1 1 100%; } }

  /* Stack of work */
  .stack { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.1fr 1fr; grid-template-rows: 1fr 1fr; gap: 0.75rem; }
  .stack li:first-child { grid-row: span 2; }
  .tile-link { display: block; height: 100%; }
  .tile-link:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .frame { position: relative; display: block; height: 100%; min-height: 10rem; overflow: hidden; background: var(--beige); }
  .stack li:first-child .frame { aspect-ratio: 9 / 16; }
  .stack li:not(:first-child) .frame { aspect-ratio: 4 / 5; }
  .frame img, .frame :global(video) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame :global(video) { opacity: 0; transition: opacity 0.35s ease; }
  .frame :global(video.playing) { opacity: 1; }
  .tile-link:hover .frame img { transform: scale(1.04); }
  .play {
    position: absolute; top: 0.6rem; left: 0.6rem; z-index: 2;
    display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%;
    background: var(--cream); color: var(--java);
  }
  /* Phones and tablets: intro first, then the row of work, then the photo and profile */
  @media (max-width: 63.99rem) {
    .copy { order: -2; }
    .stack { order: -1; }
    .photo { max-width: 26rem; }
    .stack { grid-template-columns: repeat(3, 1fr); grid-template-rows: auto; }
    .stack li:first-child { grid-row: auto; }
    .stack li .frame, .stack li:not(:first-child) .frame { aspect-ratio: 3 / 4; height: auto; min-height: 0; }
  }
</style>
