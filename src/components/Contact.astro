---
/**
 * Contact. Email, profile links and resume all come from src/data/site.json.
 * Anything still a [PLACEHOLDER] is left off the live site, so a fake address is never published.
 */
import { site, publicEmail, publishedSocials, resumeFile, isPlaceholder, showUnconfirmed } from '../lib/data';

const mailto = publicEmail ? `mailto:${publicEmail}?subject=${encodeURIComponent('Job opportunity')}` : undefined;
const pendingSocials = showUnconfirmed ? site.socials.filter((s) => isPlaceholder(s.url)) : [];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="left">
    <div class="intro">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Let's work <em>together</em></h2>
      <p class="lede">
        If you're hiring for social media, content, or creative support, send me a message here or by email and tell
        me a little about the team and the role.
      </p>
    </div>

    <div class="actions">
      {
        publicEmail ? (
          <div class="email">
            <a class="address" href={mailto}>{publicEmail}</a>
            <div class="buttons">
              <a class="btn btn-light" href={mailto}>Email me</a>
              <button type="button" class="btn btn-outline" data-copy={publicEmail}>Copy email address</button>
            </div>
            <p class="copied" role="status" aria-live="polite" data-copy-status></p>
          </div>
        ) : (
          showUnconfirmed && <p><span class="placeholder">{site.email}</span></p>
        )
      }

      {
        (publishedSocials.length > 0 || pendingSocials.length > 0) && (
          <ul class="links" role="list" aria-label="Profiles">
            {publishedSocials.map((s) => (
              <li>
                <a href={s.url} rel="me noopener" target="_blank">
                  {s.label} <span class="visually-hidden">(opens in a new tab)</span>
                  <span aria-hidden="true">&#8599;</span>
                </a>
              </li>
            ))}
            {pendingSocials.map((s) => (
              <li><span class="placeholder">{s.label}: {s.url}</span></li>
            ))}
          </ul>
        )
      }

      {
        resumeFile ? (
          <a class="resume" href={resumeFile} download>
            Download my resume <span class="meta">(PDF)</span>
          </a>
        ) : (
          showUnconfirmed && <p><span class="placeholder">{site.resumeFile}</span></p>
        )
      }
    </div>
      </div>

    <form
      class="form"
      name="contact"
      method="POST"
      action="/?sent=1#contact"
      data-netlify="true"
      netlify-honeypot="company-website"
      data-contact-form
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hp" aria-hidden="true">
        <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-company">Company <span class="opt">(optional)</span></label>
        <input id="cf-company" name="company" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>

      <button class="btn btn-light submit" type="submit">Send message</button>
      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    </form>
  </div>
</section>


<style>
  .contact {
    --bg: var(--espresso);
    --text: var(--cream);          /* 13.6:1 */
    --text-muted: var(--bisque);   /* 9.5:1 */
    --heading: var(--cream);
    --accent: var(--chambray);
    --focus: var(--chambray);
    --rule: var(--cream);
    --line: rgb(239 229 211 / 0.22);
    background: var(--bg);
    color: var(--text);
    padding-block: var(--section);
  }
  .grid { display: grid; gap: 3.5rem; align-items: start; }
  @media (min-width: 64rem) { .grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .left { display: grid; gap: 2.5rem; align-content: start; }

  /* Contact form (Netlify Forms) */
  .form { display: grid; gap: 1.1rem; }
  .hp { position: absolute; left: -9999px; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bisque); }
  .opt { font-weight: 400; letter-spacing: 0; text-transform: none; }
  .field input, .field textarea {
    width: 100%; min-height: 3rem; padding: 0.75rem 0.9rem;
    font: inherit; font-size: 1rem; color: var(--cream);
    background: rgb(244 244 241 / 0.06);
    border: 1px solid rgb(244 244 241 / 0.45); border-radius: 6px;
  }
  .field textarea { resize: vertical; min-height: 8rem; }
  .field input:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--chambray); outline-offset: 2px; border-color: var(--cream); }
  .field input:user-invalid, .field textarea:user-invalid { border-color: var(--chambray); }
  .submit { justify-self: start; cursor: pointer; }
  .submit[disabled] { opacity: 0.6; cursor: progress; }
  @media (max-width: 30rem) { .submit { justify-self: stretch; } }
  .form-status { min-height: 1.5em; font-size: var(--step-small); color: var(--bisque); }

  .intro { display: grid; gap: 1.25rem; }
  .eyebrow { color: var(--bisque); }
  h2 { font-size: var(--step-h1); line-height: 0.98; max-width: 12ch; }
  .lede { color: var(--text-muted); max-width: 46ch; }

  .actions { display: grid; gap: 2rem; }
  .email { display: grid; gap: 1.25rem; }
  /* Sans, not serif: Instrument Serif's "1" looks like an "l", which matters in an email address */
  .address {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.125rem, 0.9rem + 1.2vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--cream);
    overflow-wrap: anywhere;
  }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .btn-light { background: var(--cream); border-color: var(--cream); color: var(--java); }
  .btn-light:hover { background: var(--bisque); border-color: var(--bisque); }
  .btn-outline { background: transparent; color: var(--cream); cursor: pointer; }
  .btn-outline:hover { background: var(--cream); color: var(--java); }
  @media (max-width: 30rem) { .buttons .btn { flex: 1 1 100%; } }
  .copied { min-height: 1.5em; font-size: var(--step-small); color: var(--bisque); }

  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
  .links a {
    display: inline-flex; gap: 0.35rem; align-items: center;
    min-height: 2.75rem;
    color: var(--cream);
    font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--step-label);
  }

  .resume {
    justify-self: start;
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--cream);
    font-weight: 600;
  }
  .resume .meta { font-weight: 400; color: var(--bisque); }

</style>

<script>
  // Contact form: send without leaving the page; without JavaScript it posts normally and Netlify redirects back
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const formStatus = form?.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (formStatus) formStatus.textContent = 'Sending...';
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (formStatus) formStatus.textContent = "Thanks, your message was sent. I'll reply by email.";
    } catch {
      if (formStatus) formStatus.textContent = "Sorry, that didn't send. Please email me directly instead.";
    } finally {
      if (button) button.disabled = false;
    }
  });
  if (formStatus && new URLSearchParams(location.search).has('sent')) {
    formStatus.textContent = "Thanks, your message was sent. I'll reply by email.";
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const status = btn.closest('.email')?.querySelector<HTMLElement>('[data-copy-status]');
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        // Older or locked-down browsers: copy through a hidden text field instead
        const field = document.createElement('textarea');
        field.value = value;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.append(field);
        field.select();
        try { copied = document.execCommand('copy'); } catch { copied = false; }
        field.remove();
        btn.focus();
      }
      if (status) {
        status.textContent = copied ? 'Email address copied.' : `Couldn't copy automatically. The address is ${value}`;
      }
      window.setTimeout(() => { if (status) status.textContent = ''; }, 4000);
    });
  });
</script>
