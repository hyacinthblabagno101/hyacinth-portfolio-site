---
/**
 * Work showcase: one tab per content type (reels, ads, AI, animations, statics, stories).
 * Items come from src/data/showcase.json; media loads from Cloudinary.
 * - Statics and stories (the "grouped" tabs) show one cover per brand that opens the whole collection.
 * - Hover (mouse only): images lift, videos play a short silent preview.
 * - Click: opens the viewer with the full video (with sound) or full image, plus my role for that brand.
 * - Other tabs show the first 8 items (two rows of 4), with a button to show the rest.
 * Without JavaScript, every tile is a plain link to the full media file.
 * Selecting a tile opens the viewer (Viewer.astro, on every page).
 * Above the tabs, a Featured row of 3 to 4 pieces (ids in showcase.json "spotlight"), each with the brand, the title and
 * what I did shown as text under the media. TODO(hyacinth): confirm the picks; unbranded picks show no brand line.
 * Link to one format with ?work=<tab> (e.g. /?work=reels#work).
 */
import { showcase, groupedTabs, roleFor, groupOf, spotlight } from '../lib/data';
import { viewerEntry, tileMedia } from '../lib/showcaseMedia';

const INITIAL = 8; // two rows of 4


/** Tile shape per tab, so each grid stays even. */
const tileAspect = (key: string) => (key === 'statics' ? '4:5' : '9:16');
const sizes = '(min-width: 80rem) 19rem, (min-width: 40rem) 24vw, 46vw';

type Tile = {
  key: string;
  label: string;
  sub?: string;
  media: ReturnType<typeof tileMedia>;
  alt: string;
  kind: 'image' | 'video';
  entry: ReturnType<typeof viewerEntry>;
  items?: string;
  count?: number;
};

const featured = spotlight.map((i) => ({ item: i, media: tileMedia(i, i.aspect === '16:9' ? '16:9' : i.aspect), entry: viewerEntry(i), role: roleFor(i.brand) }));

const tabs = showcase.map((c) => {
  const aspect = tileAspect(c.key);
  let tiles: Tile[];
  if (groupedTabs.has(c.key)) {
    // One tile per brand, biggest collections first. A designs board (collage) makes the best cover.
    const byBrand = new Map<string, typeof c.items>();
    // Brands I handled through a client (e.g. Expert Biotics through Proper Ecom) share that client's cover
    const keyOf = (i: (typeof c.items)[number]) => groupOf(i.brand) ?? i.brand ?? 'More work';
    c.items.forEach((i) => byBrand.set(keyOf(i), [...(byBrand.get(keyOf(i)) ?? []), i]));
    tiles = [...byBrand.entries()]
      .sort((a, b) => b[1].length - a[1].length)
      .map(([brand, items]) => {
        const ordered = [...items.filter((i) => i.board), ...items.filter((i) => !i.board)];
        const cover = ordered[0];
        return {
          key: `${c.key}-${brand}`,
          label: brand,
          // A single designs board is a collage of many posts, so call it that rather than "1 design"
          sub: items.length === 1 && cover.board ? 'Design board' : 'Collection',
          media: tileMedia(cover, aspect),
          alt: cover.alt,
          kind: 'image',
          entry: viewerEntry(cover),
          items: ordered.map((i) => i.id).join(','), // ids; the viewer looks them up in one shared list
          count: items.length > 1 ? items.length : undefined,
        };
      });
  } else {
    tiles = c.items.map((i) => ({
      key: i.id,
      label: i.title,
      sub: i.brand,
      media: tileMedia(i, aspect),
      alt: i.alt,
      kind: i.kind,
      entry: viewerEntry(i),
    }));
  }
  return { ...c, aspect, grouped: groupedTabs.has(c.key), tiles, total: c.items.length };
});
---

<section id="work" class="showcase" aria-labelledby="work-title">
  <div class="wrap">
    <header class="section-head reveal">
      <h2 id="work-title">Selected <em>work</em></h2>
      <p class="lede">Every piece, by format. Select anything to see it in full, with my role on it.</p>
    </header>

    {featured.length > 0 && (
      <div class="featured reveal" aria-labelledby="featured-title">
        <h3 id="featured-title" class="label">Featured</h3>
        <ul class="feat-grid" role="list" data-viewer-list>
          {featured.map((f) => (
            <li class="feat">
              <a class="tile-link" href={f.entry.full} data-id={f.item.id} data-preview={f.media.preview}>
                <span class="frame" style={`aspect-ratio: ${f.item.aspect.replace(':', ' / ')}`}>
                  <img src={f.media.src} srcset={f.media.srcset} sizes="(min-width: 64rem) 18rem, 46vw" width={f.media.width} height={f.media.height} alt={f.item.alt} loading="lazy" decoding="async" />
                  {f.item.kind === 'video' && (
                    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
                  )}
                </span>
                <span class="visually-hidden">{f.item.kind === 'video' ? 'Play video' : 'View image'}: {f.item.title}</span>
              </a>
              <div class="feat-text">
                {f.item.brand && <p class="feat-brand">{f.item.brand}</p>}
                <h4 class="feat-title">{f.item.title}</h4>
                {f.role && <p class="feat-role">{f.role}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    <h3 class="label all-title">All work by format</h3>
    <div class="tabs reveal" role="tablist" aria-label="Type of work" data-tabs>
      {
        tabs.map((t, n) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.key}`}
            aria-controls={`panel-${t.key}`}
            aria-selected={n === 0 ? 'true' : 'false'}
            tabindex={n === 0 ? 0 : -1}
            data-tab={t.key}
          >
            {t.label}
          </button>
        ))
      }
    </div>

    {
      tabs.map((t, n) => (
        <div class="panel" role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} data-panel={t.key} data-active={n === 0 ? '' : undefined}>
          <h4 class="nojs-title">{t.label}</h4>
          <ul class:list={['grid', t.aspect === '4:5' ? 'grid-feed' : 'grid-tall']} role="list" data-viewer-list>
            {t.tiles.map((i, k) => (
              <li class:list={['tile', { extra: !t.grouped && k >= INITIAL }]} style={`--i: ${k % INITIAL}`}>
                <a
                  class:list={['tile-link', { collection: !!i.items }]}
                  href={i.entry.full}
                  data-id={i.items ? undefined : i.key}
                  data-preview={i.media.preview}
                  data-items={i.items}
                >
                  <span class="frame" style={`aspect-ratio: ${t.aspect.replace(':', ' / ')}`}>
                    <img
                      src={i.media.src}
                      srcset={i.media.srcset}
                      sizes={sizes}
                      width={i.media.width}
                      height={i.media.height}
                      alt={i.alt}
                      loading={n === 0 && k < 5 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    {i.kind === 'video' && (
                      <span class="play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                      </span>
                    )}
                    {i.count && (
                      <span class="stack" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="13" height="13"><path d="M4 8h12v12H4zM8 4h12v12" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                      </span>
                    )}
                    <span class="overlay" aria-hidden="true">
                      {i.items ? (
                        <>
                          <span class="title">{i.label}</span>
                          <span class="brand">View collection</span>
                        </>
                      ) : (
                        <>
                          {i.sub && <span class="brand">{i.sub}</span>}
                          <span class="title">{i.label}</span>
                        </>
                      )}
                    </span>
                  </span>
                  <span class="visually-hidden">
                    {i.items
                      ? `Open ${i.label} collection`
                      : `${i.kind === 'video' ? 'Play video' : 'View image'}: ${i.label}${i.sub ? `, ${i.sub}` : ''}`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {!t.grouped && t.tiles.length > INITIAL && (
            <button type="button" class="btn btn--secondary more" aria-expanded="false" data-more>
              Show all <span class="visually-hidden">{t.label}</span>
              <span aria-hidden="true">&darr;</span>
            </button>
          )}
        </div>
      ))
    }
  </div>

</section>

<style>
  .showcase { padding-block: var(--section); background: var(--paper); }

  /* Tabs: a quiet underline that slides to the active tab */
  .tabs {
    display: flex; gap: 0.25rem 1.75rem; flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2rem;
  }
  /* Tabs wrap onto a second line on phones (no sideways scrolling); the selected tab is underlined */
  .tabs button {
    position: relative;
    display: inline-flex; align-items: baseline; gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    background: none; border: 0; cursor: pointer;
    font: inherit; font-weight: 600; font-size: var(--fs-small);
    letter-spacing: 0.01em;
    color: var(--muted);
    transition: color 0.25s ease;
  }
  .tabs button::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
    background: var(--ink);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tabs button:hover { color: var(--ink); }
  .tabs button[aria-selected='true'] { color: var(--ink); }
  .tabs button[aria-selected='true']::after { transform: scaleX(1); }

  /* Featured row */
  .featured { margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem); }
  .featured .label { color: var(--muted); margin-bottom: 1rem; }
  .feat-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 64rem) { .feat-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; } }
  .feat { display: grid; gap: 0.75rem; align-content: start; }
  .feat-text { display: grid; gap: 0.2rem; }
  .feat-brand { font-size: var(--fs-small); font-weight: 600; color: var(--muted); }
  .feat-title { font-family: var(--font-sans); font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
  .feat-role { font-size: var(--fs-small); color: var(--muted); max-width: 40ch; }
  .all-title { color: var(--muted); margin-bottom: 0.25rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .grid-tall { grid-template-columns: repeat(2, 1fr); }
  .grid-feed { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 40rem) {
    .grid { gap: 1rem; }
    .grid-tall, .grid-feed { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 64rem) { .grid { gap: 1.25rem; } }

  :global(html.js) .tile.extra { display: none; }
  /* Without JavaScript: no tabs; every format shows, one after another, under its own heading */
  .nojs-title { display: none; }
  :global(html:not(.js)) .nojs-title { display: block; margin: 2rem 0 1rem; font-size: var(--fs-h3); font-weight: 600; }
  :global(html:not(.js)) .tabs { display: none; }
  /* With JavaScript, only the active format shows, from the first paint (no layout jump) */
  :global(html.js) .panel:not([data-active]) { display: none; }
  :global(html:not(.js)) .more { display: none; }
  .panel[data-expanded] .tile.extra { display: block; }

  .tile-link { display: block; color: inherit; text-decoration: none; border-radius: var(--radius-media); }
  .frame {
    position: relative; display: block; overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--surface);
  }
  .frame img, .frame :global(video) {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame :global(video) { opacity: 0; transition: opacity 0.35s ease; }
  .frame :global(video.playing) { opacity: 1; }

  .play {
    position: absolute; top: 0.6rem; right: 0.6rem; z-index: 2;
    display: grid; place-items: center;
    width: 1.9rem; height: 1.9rem; border-radius: 50%;
    background: rgb(52 23 23 / 0.55); color: var(--paper);
    backdrop-filter: blur(4px);
    transition: opacity 0.3s ease;
  }
  .stack {
    position: absolute; top: 0.6rem; right: 0.6rem; z-index: 2;
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.25rem 0.55rem; border-radius: var(--radius-pill);
    background: rgb(52 23 23 / 0.6); color: var(--paper);
    font-size: var(--fs-label); font-weight: 600;
    backdrop-filter: blur(4px);
  }
  .overlay {
    position: absolute; inset: auto 0 0 0; z-index: 2;
    display: grid; gap: 0.15rem;
    padding: 2.5rem 0.85rem 0.85rem;
    background: linear-gradient(to top, rgb(52 23 23 / 0.82), rgb(52 23 23 / 0));
    color: var(--paper);
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .brand { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.01em; color: var(--paper); }
  .title { font-size: var(--fs-small); font-weight: 600; line-height: 1.2; }

  /* Hover and keyboard focus show the same details */
  .tile-link:hover .frame img, .tile-link:focus-visible .frame img { transform: scale(1.04); }
  .tile-link:hover .overlay, .tile-link:focus-visible .overlay { opacity: 1; transform: none; }
  .tile-link:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  /* Touch screens can't hover, so the title is always shown there */
  /* Brand collections always show their name, since the cover alone doesn't say whose work it is */
  .collection .overlay { opacity: 1; transform: none; }
  @media (hover: none) {
    .overlay { opacity: 1; transform: none; padding-top: 1.75rem; }
    .tile-link:not(.collection) .overlay .title { display: none; }
  }

  .more { display: flex; width: fit-content; margin: 2rem auto 0; }
  .panel[data-expanded] .more { display: none; }

  /* Staggered fade-in when a tab opens or more items are shown */
  @media (prefers-reduced-motion: no-preference) {
    .panel.animate .tile { animation: tile-in 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; animation-delay: calc(var(--i, 0) * 40ms); }
    @keyframes tile-in { from { opacity: 0; transform: translateY(10px); } }
  }

</style>

<script>
  const tablist = document.querySelector<HTMLElement>('[data-tabs]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  function select(tab: HTMLButtonElement, focus = false) {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => {
      const on = p.dataset.panel === tab.dataset.tab;
      p.hidden = !on;
      p.toggleAttribute('data-active', on);
      if (on) {
        p.classList.remove('animate');
        void p.offsetWidth; // restart the fade-in
        p.classList.add('animate');
      }
    });
    if (focus) tab.focus();
  }

  tablist?.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (tab) select(tab);
  });
  // Arrow keys move between tabs (standard tab pattern)
  tablist?.addEventListener('keydown', (e) => {
    const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
    if (i < 0) return;
    const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
    if (next === undefined) return;
    e.preventDefault();
    select(tabs[(next + tabs.length) % tabs.length], true);
  });
  // ?work=statics opens that tab, so a recruiter can be sent straight to one format.
  // #work?filter=reels also works.
  const preset = new URLSearchParams(location.search).get('work') ?? new URLSearchParams(location.hash.split('?')[1] ?? '').get('filter');
  const presetTab = tabs.find((t) => t.dataset.tab === preset);
  // Panels are all visible without JavaScript; with it, only the selected format shows
  select(presetTab ?? tabs[0]);
  if (presetTab) {
    // "#work?filter=..." isn't a real anchor, so scroll to the section once the page has laid out
    if (location.hash.startsWith('#work?')) {
      const go = () => document.getElementById('work')?.scrollIntoView({ behavior: 'instant' });
      requestAnimationFrame(() => requestAnimationFrame(go));
      window.setTimeout(go, 300);
      window.addEventListener('load', go, { once: true });
    }
  }

  // "Show all": reveal the rest and move focus to the first new item
  document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.closest<HTMLElement>('[data-panel]')!;
      panel.dataset.expanded = '';
      btn.setAttribute('aria-expanded', 'true');
      panel.classList.remove('animate');
      void panel.offsetWidth;
      panel.classList.add('animate');
      panel.querySelector<HTMLElement>('.tile.extra .tile-link')?.focus({ preventScroll: true });
    });
  });

  // Hover previews: a short silent loop, loaded only when the pointer arrives (any tile on the page)
  document.querySelectorAll<HTMLAnchorElement>('a.tile-link[data-preview]').forEach((link) => {
    let video: HTMLVideoElement | null = null;
    link.addEventListener('pointerenter', () => {
      if (!canHover.matches || reduce.matches) return;
      const frame = link.querySelector('.frame');
      if (!frame) return;
      if (!video) {
        video = document.createElement('video');
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.setAttribute('aria-hidden', 'true');
        video.src = link.dataset.preview!;
        video.addEventListener('playing', () => video?.classList.add('playing'));
        frame.append(video);
      }
      video.play().catch(() => {});
    });
    link.addEventListener('pointerleave', () => {
      if (!video) return;
      video.pause();
      video.classList.remove('playing');
    });
  });

</script>
