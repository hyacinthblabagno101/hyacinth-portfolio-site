---
/**
 * Credentials: certifications and the tools I use.
 * - Certifications: "certifications" in src/data/proof.json (each opens the certificate in a new tab).
 * - Tools: src/data/tools.json, shown as icons (name on hover and for screen readers). A tool marked with
 *   "check" is one I wasn't sure about; it only shows while previewing, until the check line is removed.
 */
import { proof, tools, showUnconfirmed } from '../lib/data';
import { jpgUrl } from '../lib/cloudinary';
import { toolIcon } from '../lib/toolIcons';

const toolList = tools.groups
  .flatMap((g) => g.tools.map((t) => (typeof t === 'string' ? { name: t, check: undefined } : t)))
  .filter((t) => !t.check || showUnconfirmed)
  .map((t) => ({ ...t, icon: toolIcon(t.name) }));
---

<section id="credentials" class="credentials" aria-labelledby="credentials-title">
  <div class="wrap">
    <header class="section-head reveal">
      <h2 id="credentials-title">Courses &amp; <em>tools</em></h2>
      <p class="lede">Certificates I've earned and the tools I use day to day.</p>
    </header>
    <div class="extras">
      <div id="certifications" class="block">
        <h3>Certifications</h3>
        <ul class="certs" role="list">
          {proof.certifications.map((c) => (
            <li>
              <a href={jpgUrl(c.image, 1600)} target="_blank" rel="noopener">
                <img src={jpgUrl(c.image, 160)} width="64" height="48" alt="" loading="lazy" decoding="async" />
                <span class="cert-text">
                  <span class="title">{c.title}</span>
                  <span class="issuer">{c.issuer} &middot; {c.date}</span>
                </span>
                <span class="visually-hidden">(opens the certificate in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div id="tools" class="block">
        <h3>Tools I use</h3>
        <ul class="tools" role="list">
          {toolList.map((t) => (
            <li class:list={['tool', { unsure: t.check }]} data-name={t.name} title={t.check ? `${t.name} (check: ${t.check})` : t.name}>
              <span class="visually-hidden">{t.name}</span>
              {t.icon.type === 'icon' ? (
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={t.icon.path} fill={t.icon.color} /></svg>
              ) : (
                <span class="mono" aria-hidden="true" style={`background:${t.icon.bg};color:${t.icon.fg}`}>{t.icon.text}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .credentials { padding-block: var(--section); background: var(--greige); overflow-x: clip; } /* hidden tool name tips near the edge never widen the page */
  /* Certifications and tools */
  .extras {
    display: grid; gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  @media (min-width: 64rem) { .extras { grid-template-columns: 1.15fr 1fr; } }
  .block { display: grid; gap: 1.25rem; align-content: start; scroll-margin-top: 5rem; }
  .block h3 { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--wine); }

  .certs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .certs li { border-bottom: 1px solid var(--line); }
  .certs a {
    display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1rem; align-items: center;
    padding: 0.75rem 0; color: var(--ink); text-decoration: none;
    transition: padding 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .certs a:hover { padding-left: 0.4rem; }
  .certs img { width: 4rem; height: 3rem; object-fit: cover; border-radius: 4px; background: #fff; border: 1px solid var(--line); }
  .cert-text { display: grid; gap: 0.1rem; }
  .title { font-weight: 600; line-height: 1.3; }
  .certs a:hover .title { color: var(--wine); text-decoration: underline; text-underline-offset: 0.2em; }
  .issuer { font-size: var(--fs-small); color: var(--text-muted); }

  /* Tools: icon tiles, name shown on hover */
  .tools { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr)); gap: 0.5rem; }
  .tool {
    position: relative; display: grid; place-items: center;
    aspect-ratio: 1; border-radius: var(--radius-media); background: var(--paper);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .tool:hover { transform: translateY(-3px); box-shadow: 0 8px 18px -10px rgb(34 21 22 / 0.4); }
  .tool.unsure { outline: 2px dashed #8a6d00; }
  .mono { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 5px; font-weight: 700; font-size: 0.6875rem; }
  .tool::after {
    content: attr(data-name);
    position: absolute; bottom: calc(100% + 6px); left: 50%; z-index: 2;
    padding: 0.25rem 0.5rem; border-radius: 4px; white-space: nowrap;
    background: var(--ink); color: var(--paper); font-size: var(--fs-label);
    opacity: 0; transform: translate(-50%, 4px); pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .tool:hover::after { opacity: 1; transform: translate(-50%, 0); }
</style>
