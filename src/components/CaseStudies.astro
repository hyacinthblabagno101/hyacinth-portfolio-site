---
/**
 * UGC & influencer marketing case studies, kept simple:
 * 1. Influencer marketing: one phone per creator collaboration (video, brand x creator, audience, deal, what I did).
 * 2. UGC gifting collaborations: a row of UGC sample videos with a short note.
 * 3. Monthly reporting: two compact report cards.
 * Phones open the video in the viewer (Viewer.astro) at its own 9:16 size.
 * It lives in a pop-up, not on the page: it opens from the "UGC & Influencer" card in What I do
 * (any [data-open-cases] button, or a link to #case-studies).
 * Text and video IDs: "caseStudies" and "platforms" in src/data/proof.json.
 */
import { proof } from '../lib/data';
import { site } from '../lib/data';
import { videoUrl } from '../lib/cloudinary';

const byId = Object.fromEntries(proof.caseStudies.map((c) => [c.id, c]));
const influencer = byId.influencer;
const ugc = byId.ugc;
const analytics = byId.analytics;
const { platforms } = proof;

// Cover frame taken 3 seconds in: several of these videos open on a dark frame
const frame = (media: string, w: number) =>
  `https://res.cloudinary.com/${site.cloudName}/video/upload/so_3,f_auto,q_auto,w_${w},ar_9:16,c_fill,g_auto/${media}.jpg`;
const phone = (media: string, title: string, brand: string | undefined, alt: string) => ({
  full: videoUrl(media),
  poster: frame(media, 720),
  thumb: frame(media, 360),
  title, brand, alt,
});
const creators = (influencer?.rows ?? []).filter((r) => r.video).map((r) => ({
  ...r,
  v: phone(r.video!, `${r.creator} x ${r.brand}`, r.brand, `Creator video by ${r.creator} for ${r.brand}`),
}));
const ugcVideos = (ugc?.videos ?? []).map((v) => phone(v.media, v.title, undefined, v.alt));
---

<dialog id="case-studies" class="cases" aria-labelledby="cases-title" data-cases>
  <div class="bar">
    <p class="bar-label">Case studies</p>
    <button type="button" class="x" data-cases-close aria-label="Close case studies">&times;</button>
  </div>
  <div class="body">
    <header class="section-head">
      <h2 id="cases-title">UGC &amp; influencer <em>marketing</em></h2>
      <p class="lede">
        I've built and run creator campaigns in {platforms.used.join(' and ')}, and I'm comfortable in similar platforms like {platforms.similar.join(', ')}.
      </p>
    </header>

    {influencer && (
      <article class="panel light" aria-labelledby="case-influencer">
        <div class="panel-head">
          <h3 id="case-influencer">{influencer.title}</h3>
          <p>{influencer.intro}</p>
        </div>
        <ul class="phones" role="list" data-viewer-list>
          {creators.map((c) => (
            <li>
              <a class="tile-link phone" href={c.v.full} data-kind="video" data-full={c.v.full} data-poster={c.v.poster} data-title={c.v.title} data-brand={c.v.brand} data-alt={c.v.alt} data-aspect="9:16">
                <img src={c.v.thumb} width="360" height="640" alt="" loading="lazy" decoding="async" />
                <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
                <span class="visually-hidden">Play video: {c.v.title}</span>
              </a>
              <p class="who"><strong>{c.brand}</strong> <span aria-hidden="true">&times;</span> {c.creator}</p>
              <p class="tags">{c.audience} &middot; {c.deal}</p>
              <p class="detail">{c.detail}</p>
            </li>
          ))}
        </ul>
      </article>
    )}

    {ugc && (
      <article class="panel dark" aria-labelledby="case-ugc">
        <div class="panel-head">
          <h3 id="case-ugc">{ugc.title}</h3>
          <p>{ugc.intro}</p>
        </div>
        <ul class="phones" role="list" data-viewer-list>
          {ugcVideos.map((v, i) => (
            <li>
              <a class="tile-link phone" href={v.full} data-kind="video" data-full={v.full} data-poster={v.poster} data-title={`UGC sample ${i + 1}`} data-alt={v.alt} data-aspect="9:16">
                <img src={v.thumb} width="360" height="640" alt="" loading="lazy" decoding="async" />
                <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
                <span class="visually-hidden">Play UGC sample {i + 1}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    )}

    {analytics?.reports && (
      <article class="reports" aria-labelledby="case-reports">
        <div class="panel-head">
          <h3 id="case-reports">{analytics.title}</h3>
          <p>{analytics.intro}</p>
        </div>
        <div class="report-grid">
          {analytics.reports.map((r) => (
            <figure class="report">
              <figcaption>{r.label}</figcaption>
              <dl>
                {r.stats.map((s) => (
                  <div><dt>{s.label}</dt><dd>{s.value}{s.change && <span>{s.change}</span>}</dd></div>
                ))}
              </dl>
              <p>{r.note}</p>
            </figure>
          ))}
        </div>
      </article>
    )}
  </div>
</dialog>

<style>
  /* The pop-up: nearly full screen, scrolls inside, close button always at the top */
  .cases {
    width: min(100vw - 1.5rem, 76rem); max-width: none; height: calc(100dvh - 1.5rem); max-height: none;
    margin: auto; padding: 0; border: 0; border-radius: var(--radius-panel);
    background: var(--paper); color: var(--ink); overflow: hidden;
  }
  .cases[open] { display: flex; flex-direction: column; animation: cases-in 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes cases-in { from { opacity: 0; transform: translateY(16px); } }
  .cases::backdrop { background: rgb(53 30 40 / 0.75); backdrop-filter: blur(3px); }
  .bar {
    flex: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 0.75rem clamp(1rem, 0.75rem + 1.5vw, 2rem); border-bottom: 1px solid var(--line); background: var(--paper);
  }
  .bar-label { font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.01em; color: var(--wine); }
  .x {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--line); background: var(--paper);
    color: var(--ink); font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .x:hover { background: var(--wine); color: var(--paper); border-color: var(--wine); }
  .body {
    flex: 1; overflow-y: auto; overscroll-behavior: contain;
    display: grid; align-content: start; gap: clamp(1.25rem, 1rem + 1vw, 2rem);
    padding: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(1rem, 0.75rem + 1.5vw, 2rem);
  }
  .cases .section-head { margin-bottom: 0.5rem; }
  .cases h2 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem); }

  .panel { border-radius: var(--radius-panel); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); display: grid; gap: 1.75rem; }
  .light { background: var(--paper); border: 1px solid var(--line); }
  .dark { background: var(--wine); color: var(--paper); }
  .panel-head { display: grid; gap: 0.6rem; max-width: 62ch; }
  .panel-head h3 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); letter-spacing: -0.02em; line-height: 1.15; color: inherit; }
  .panel-head p { color: var(--text-muted); }
  .dark .panel-head p { color: rgb(250 249 246 / 0.8); }

  /* Phones stay at a modest, fixed size (always 9:16, like the videos), not stretched to the panel width */
  .phones {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 12.5rem)); justify-content: start;
  }
  @media (max-width: 30rem) { .phones { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .phones li { display: grid; gap: 0.5rem; align-content: start; }

  /* A phone frame around each video */
  .phone {
    position: relative; display: block; aspect-ratio: 9 / 16; overflow: hidden;
    border: 5px solid var(--ink); border-radius: 1.4rem; background: var(--ink);
    box-shadow: 0 18px 34px -22px rgb(53 30 40 / 0.6);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .phone::before { content: ''; position: absolute; top: 0.45rem; left: 50%; z-index: 2; width: 30%; height: 0.9rem; border-radius: 1rem; background: var(--ink); transform: translateX(-50%); }
  .phone img { width: 100%; height: 100%; object-fit: cover; border-radius: 1rem; }
  .phone:hover { transform: translateY(-4px); }
  .phone:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .play {
    position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%;
    background: rgb(250 249 246 / 0.92); color: var(--wine);
    transition: transform 0.3s ease;
  }
  .phone:hover .play { transform: translate(-50%, -50%) scale(1.08); }

  .who { font-size: var(--fs-small); }
  .who strong { font-weight: 700; }
  .tags { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.04em; color: var(--wine); }
  .detail { font-size: var(--fs-small); color: var(--text-muted); }

  /* Reporting */
  .reports { --text-muted: rgb(53 30 40 / 0.8); display: grid; gap: 1.25rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: var(--radius-panel); background: var(--blue); }
  .report-grid { display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .report-grid { grid-template-columns: 1fr 1fr; } }
  .report { margin: 0; display: grid; gap: 0.75rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-media); background: var(--paper); }
  .report figcaption { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.01em; color: var(--text-muted); }
  .report dl { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .report dt { font-size: var(--fs-small); color: var(--text-muted); order: 2; }
  .report dd { margin: 0; font-size: var(--fs-h3); font-weight: 700; letter-spacing: -0.04em; color: var(--wine); order: 1; }
  .report dd span { display: block; font-size: var(--fs-small); font-weight: 600; letter-spacing: 0; color: var(--ink); }
  .report dl div { display: flex; flex-direction: column; }
  .report > p { font-size: var(--fs-small); color: var(--text-muted); }
</style>

<script>
  // Open from any [data-open-cases] button or #case-studies link; X, Escape, or a click outside closes it.
  const cases = document.querySelector<HTMLDialogElement>('[data-cases]');
  if (cases) {
    let opener: HTMLElement | null = null;
    const open = (from?: HTMLElement | null) => {
      opener = from ?? null;
      document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d !== cases && d.close());
      if (!cases.open) cases.showModal();
      cases.querySelector('.body')?.scrollTo(0, 0);
    };
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-open-cases], a[href$="#case-studies"]');
      if (!t) return;
      e.preventDefault();
      open(t.closest('dialog') ? document.querySelector<HTMLElement>(`[data-open="${t.closest('dialog')!.id}"]`) : t);
    });
    cases.querySelector('[data-cases-close]')?.addEventListener('click', () => cases.close());
    cases.addEventListener('click', (e) => { if (e.target === cases) cases.close(); });
    cases.addEventListener('close', () => opener?.focus());
    if (location.hash === '#case-studies') open();
  }
</script>
